---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist on Room Census." indexable={false}>
  <section aria-labelledby="missing-title" class="grid min-h-[50vh] place-content-center justify-items-center gap-4 text-center">
    <p class="font-mono text-sm tracking-widest text-text-muted">404</p>
    <h1 id="missing-title" class="text-3xl font-semibold">This page does not exist</h1>
    <p class="text-text-secondary">The address may be mistyped, or the page may have moved.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 font-bold text-on-accent no-underline">Go to the overview</a>
      <a href="/rooms/" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 font-semibold text-text no-underline">Browse rooms</a>
    </div>
  </section>
</Base>
