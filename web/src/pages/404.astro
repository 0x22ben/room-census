---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist on Room Census." indexable={false}>
  <section class="wrap intro" aria-labelledby="missing-title">
    <p class="eyebrow">404</p>
    <h1 id="missing-title">This page does not exist</h1>
    <p class="lead">The address may be mistyped, or the page may have moved.</p>
    <p><a class="action" href="/">Go to the overview</a></p>
  </section>
</Base>

<style>
  .intro { padding-block: var(--space-7) var(--space-5); display: grid; gap: var(--space-4); justify-items: start; }
  .lead { color: var(--color-text-secondary); font-size: var(--text-lg); }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding: 0 var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 650;
    text-decoration: none;
  }
</style>
