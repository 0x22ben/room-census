---
// The contests the witness follows, running first. A card opens the contest and says where our capture
// of it begins: nothing here claims data from before that.
import Base from "../../layouts/Base.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Info from "@lucide/astro/icons/info";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import ShieldAlert from "@lucide/astro/icons/shield-alert";
import { SAMPLE, CAPTURED_AT, contests, coverageLine, phaseLabel, phaseOf } from "../../lib/contests";
import { dateTimeUtc } from "../../lib/format";

const all = contests();
const groups = [
  { label: "Running", items: all.filter((c) => phaseOf(c) !== "ended") },
  { label: "Ended", items: all.filter((c) => phaseOf(c) === "ended") },
].filter((g) => g.items.length > 0);
const fact = "grid gap-1";
---
<Base title="Contests" description="The FLOP Labs contests on Technocore that Room Census follows, with what we could check from the signed records we saved.">
  <section aria-labelledby="contests-title" class="grid gap-1.5">
    <h1 id="contests-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Contests we follow</h1>
    <p class="text-text-muted">FLOP Labs contests on Technocore, with what we could check from the signed records we saved.</p>
  </section>

  <p class="mt-3 flex items-start gap-2 rounded-md border border-border bg-surface px-3 py-2 text-sm text-text-secondary">
    <Info size={16} aria-hidden="true" class="mt-0.5 shrink-0 text-text-muted" />
    {SAMPLE
      ? <span>Sample data: a copy of our capture from {dateTimeUtc(CAPTURED_AT)}. This page does not update yet.</span>
      : <span>From our capture of {dateTimeUtc(CAPTURED_AT)}. This page is rebuilt about every 15 minutes.</span>}
  </p>

  <p class="mt-3 text-sm text-text-muted">A contest appears here once we follow it. Each one says which records we hold and from when, and we never show records we do not hold.</p>

  {groups.map((g) => (
    <section aria-label={`${g.label} contests`} class="mt-6 grid gap-3">
      <h2 class="font-mono text-xs font-bold tracking-widest text-text-muted uppercase">{g.label}</h2>
      {g.items.map((c) => (
        <article class="grid gap-4 rounded-lg border border-border bg-surface p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="grid min-w-0 flex-1 gap-1.5">
              <div class="flex flex-wrap items-center gap-2.5">
                <h3 class="text-xl font-medium"><a href={`/contests/${c.id}/`} class="text-text no-underline hover:underline">{c.title}</a></h3>
                {phaseOf(c) === "live"
                  ? <span class="inline-flex items-center gap-1.5 rounded-md border border-accent-border bg-accent-soft px-2 py-0.5 text-xs font-semibold text-accent"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>Live</span>
                  : <span class="rounded-md border border-border bg-surface-raised px-2 py-0.5 text-xs font-semibold text-text-secondary">{phaseLabel(phaseOf(c))}</span>}
              </div>
              <p class="text-sm text-text-secondary">{c.summary}</p>
              <p class="text-xs text-text-muted">{coverageLine(c)}</p>
            </div>
            <a href={`/contests/${c.id}/`} aria-label={`Open ${c.title}`} class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-4 text-sm font-semibold text-text no-underline">Open <ArrowRight size={16} aria-hidden="true" class="text-text-secondary" /></a>
          </div>
          <dl class="grid grid-cols-2 gap-4 border-t border-border pt-3.5 sm:grid-cols-4">
            {phaseOf(c) === "ended"
              ? <div class={fact}><dt class="text-xs text-text-muted">Ended</dt><dd>{dateTimeUtc(c.final_price_at ?? c.trading_lock_at)}</dd></div>
              : phaseOf(c) === "closed"
                ? <div class={fact}><dt class="text-xs text-text-muted">Final price at</dt><dd>{dateTimeUtc(c.final_price_at!)}</dd></div>
                : <div class={fact}><dt class="text-xs text-text-muted">Trading closes</dt><dd>{dateTimeUtc(c.trading_lock_at)}</dd></div>}
            {c.latest
              ? <div class={fact}><dt class="text-xs text-text-muted">Players</dt><dd class="tabular-nums">{c.latest.owners.toLocaleString("en-US")}</dd></div>
              : <div class={fact}><dt class="text-xs text-text-muted">Winner, {c.winner_source}</dt><dd>{c.winner ?? "–"}</dd></div>}
            <div class={fact}><dt class="text-xs text-text-muted">Prize</dt><dd>{c.prize}</dd></div>
            <div class={fact}><dt class="text-xs text-text-muted">Our check</dt>
              <dd class:list={["flex items-center gap-1.5 font-medium", c.check.level === "ok" ? "text-accent" : "text-warning"]}>
                {c.check.level === "ok" ? <ShieldCheck size={16} aria-hidden="true" /> : <ShieldAlert size={16} aria-hidden="true" />}{c.check.label}
              </dd>
            </div>
          </dl>
        </article>
      ))}
    </section>
  ))}
</Base>
