---
// The contests the witness follows (Pencil mockup MXuy7): the running contest as a wide card with its
// pixel picture and its key numbers, then the ended ones and the next to come as small cards. Each card
// opens the contest; where our capture of it begins is in its check's help, and on its Verify page.
import Base from "../../layouts/Base.astro";
import Help from "../../components/Help.astro";
import PixelScene from "../../components/PixelScene.astro";
import Px from "../../components/Px.astro";
import { SAMPLE, CAPTURED_AT, contests, countdown, coverageLine, phaseLabel, phaseOf, type Contest } from "../../lib/contests";
import { dateTimeUtc } from "../../lib/format";
import { TINT } from "../../lib/pixel-scenes.mjs";

const all = contests();
const running = all.filter((c) => phaseOf(c) !== "ended");
const ended = all.filter((c) => phaseOf(c) === "ended");
const n = (v: number) => v.toLocaleString("en-US");
const compact = (v: number) => (v >= 1e6 ? `${+(v / 1e6).toFixed(1)}M` : v >= 1e3 ? `${Math.round(v / 1e3)}K` : String(v));
const prizeShort = (p: string) => p.replace(/^([\d,]+) FLOP$/, (_, d: string) => `${compact(Number(d.replace(/,/g, "")))} FLOP`);
const tint = (id: string) => TINT[id as keyof typeof TINT] ?? TINT["close-1"];
// the date too: a day-old capture must not look fresh
const at = new Date(CAPTURED_AT);
const time = `${at.getUTCDate()} ${"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(" ")[at.getUTCMonth()]} ${at.toISOString().slice(11, 16)}`;
type Stat = { label: string; value: string; gold?: boolean };
/** The numbers of a card: prize, then time left or the winner, then the active traders. */
function stats(c: Contest, short: boolean): Stat[] {
  const p = phaseOf(c);
  const out: Stat[] = [{ label: "Prize", value: short ? prizeShort(c.prize) : c.prize, gold: true }];
  if (p === "live") out.push({ label: "Ends in", value: countdown(c.trading_lock_at) });
  else if (p === "upcoming") out.push({ label: "Starts in", value: countdown(c.opening) });
  else if (p === "closed") out.push({ label: "Final price at", value: dateTimeUtc(c.final_price_at!) });
  else if (c.winner) out.push({ label: c.winner_source === "named by the referee" ? "Winner · referee" : "Winner", value: c.winner });
  if (c.ranking) out.push({ label: "Traders", value: short ? compact(c.ranking.traders) : n(c.ranking.traders) });
  return out;
}
const chip = "inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest uppercase";
const label = "font-['Silkscreen'] text-[10px] tracking-wider text-text-muted uppercase";
const link = "text-text no-underline outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline";
---
<Base title="Technocore contests: live leaderboards" description="The FLOP Labs contests on Technocore that Room Census follows, with what we could check from the signed records we saved.">
  <section aria-labelledby="contests-title" class="flex flex-wrap items-end justify-between gap-3">
    <div class="grid gap-1.5">
      <h1 id="contests-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Contests</h1>
      <p class="text-text-muted">FLOP Labs contests we follow, from the signed records we keep.</p>
    </div>
    <p class="flex items-center gap-2 font-mono text-xs text-text-muted">
      {SAMPLE
        ? <span>Sample data from {dateTimeUtc(CAPTURED_AT)}</span>
        : <><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span><span>Updated {time} UTC · every 15 min</span></>}
    </p>
  </section>

  {running.length > 0 && (
    <section aria-label="Running contests" class="mt-6 grid gap-3">
      <h2 class="font-mono text-xs font-bold tracking-widest text-text-muted uppercase">Running</h2>
      {running.map((c) => (
        <article class="relative grid overflow-hidden rounded-2xl border border-accent-border bg-surface transition-colors hover:border-accent md:grid-cols-[minmax(0,26rem)_1fr]" data-contest-card={c.id}>
          <div class:list={["grid place-items-center bg-linear-to-b to-bg px-6 py-6", tint(c.id)]}>
            <PixelScene id={c.id} class="w-full max-w-sm" />
          </div>
          <div class="grid content-between gap-5 p-5 sm:p-7">
            <div class="grid gap-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-xl font-semibold"><a href={`/contests/${c.id}/`} class={link}>{c.title}</a></h3>
                {phaseOf(c) === "live"
                  ? <span class:list={[chip, "border-accent-border bg-accent-soft text-accent"]}><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>Live</span>
                  : <span class:list={[chip, "border-border-strong bg-surface-raised text-text-secondary"]}>{phaseLabel(phaseOf(c))}</span>}
              </div>
              <p class="text-sm text-text-secondary">{c.summary}</p>
            </div>
            <dl class="flex flex-wrap gap-x-10 gap-y-4">
              {stats(c, false).map((s) => (
                <div class="grid gap-1"><dt class={label}>{s.label}</dt><dd class:list={["font-mono text-xl font-bold tabular-nums sm:text-2xl", s.gold ? "text-[#e3b341]" : "text-text"]}>{s.value}</dd></div>
              ))}
            </dl>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class:list={["relative z-10 flex items-center gap-1.5 text-sm font-semibold", c.check.level === "ok" ? "text-accent" : "text-warning"]}>
                <span class="size-2 bg-current" aria-hidden="true"></span>{c.check.label}
                <Help term={c.check.label} id={`help-check-${c.id}`} ask="What does our check cover?" text={coverageLine(c)} />
              </p>
              <span class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-accent px-4 text-sm font-bold text-on-accent" aria-hidden="true">Open the contest <Px name="arrow-right" size={12} /></span>
            </div>
          </div>
        </article>
      ))}
    </section>
  )}

  <section aria-label="Ended contests and the next one" class="mt-8 grid gap-3">
    <h2 class="font-mono text-xs font-bold tracking-widest text-text-muted uppercase">{ended.length ? "Ended · Next" : "Next"}</h2>
    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {ended.map((c) => (
        <article class="relative grid content-start overflow-hidden rounded-2xl border border-border bg-surface transition-colors hover:border-border-strong" data-contest-card={c.id}>
          <div class:list={["bg-linear-to-b to-bg", tint(c.id)]}><PixelScene id={c.id} class="w-full" /></div>
          <div class="grid gap-3 p-5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-lg font-semibold"><a href={`/contests/${c.id}/`} class={link}>{c.title}</a></h3>
              <span class:list={[chip, "border-border-strong bg-surface-raised text-text-secondary"]}>{phaseLabel(phaseOf(c))}</span>
            </div>
            <p class="text-sm text-text-secondary">{c.summary}</p>
            <dl class="grid grid-cols-2 gap-3">
              {stats(c, true).map((s) => (
                <div class="grid min-w-0 gap-1"><dt class={label}>{s.label}</dt><dd class:list={["truncate font-mono font-bold", s.gold ? "text-[#e3b341]" : "text-text"]}>{s.value}</dd></div>
              ))}
            </dl>
            <div class="flex items-center justify-between gap-3 border-t border-border pt-3">
              <p class:list={["relative z-10 flex items-center gap-1.5 text-xs font-semibold", c.check.level === "ok" ? "text-accent" : "text-warning"]}>
                <span class="size-2 bg-current" aria-hidden="true"></span>{c.check.label}
                <Help term={c.check.label} id={`help-check-${c.id}`} ask="What does our check cover?" text={coverageLine(c)} />
              </p>
              <span class="flex items-center gap-1.5 text-sm font-semibold text-text" aria-hidden="true">Results <Px name="arrow-right" size={12} class="text-accent" /></span>
            </div>
          </div>
        </article>
      ))}
      <article class="relative grid content-start overflow-hidden rounded-2xl border border-dashed border-border-strong bg-surface" data-contest-card="next">
        <div class:list={["bg-linear-to-b to-bg", TINT.next]}><PixelScene id="next" class="w-full" /></div>
        <div class="grid gap-3 p-5">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-lg font-semibold">Next contest</h3>
            <span class:list={[chip, "border-warning-border bg-warning-soft text-warning"]}>Soon</span>
          </div>
          <p class="text-sm text-text-secondary">Shows up here when FLOP Labs opens it.</p>
          <div class="flex items-center justify-end border-t border-border pt-3">
            <a href="/rankings/" class="flex min-h-11 items-center gap-1.5 text-sm font-semibold text-text no-underline hover:underline">Rankings <Px name="arrow-right" size={12} class="text-accent" /></a>
          </div>
        </div>
      </article>
    </div>
  </section>
</Base>
