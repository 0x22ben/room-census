---
// The leaderboard and the overview became one page, Live, on 27 Sep 2026. This address stays for old
// links: it sends the reader on, and says where in plain words if the browser does not follow.
import Base from "../../../layouts/Base.astro";
import { contests, type Contest } from "../../../lib/contests";

export function getStaticPaths() {
  return contests().filter((c) => c.leaderboard).map((c) => ({ params: { id: c.id }, props: { contest: c } }));
}
interface Props { contest: Contest }
const { contest: c } = Astro.props;
const to = `/contests/${c.id}/`;
---
<Base title={`${c.short} leaderboard`} description={`The ${c.title} leaderboard is now on its Live page.`} refresh={to}>
  <p class="text-text-secondary">The leaderboard moved to the <a class="text-link" href={to}>{c.short} Live page</a>.</p>
</Base>
