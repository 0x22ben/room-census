---
// A contest, live: five numbers, the chart, "Find my DID" and the referee's signed top list checked by
// our recount. Keys that never traded are not ranked; searching one says so. Room Census builds no
// ranking of its own beyond what the recount of signed trades gives.
import Base from "../../../layouts/Base.astro";
import ContestHeader from "../../../components/ContestHeader.astro";
import Help from "../../../components/Help.astro";
import Px from "../../../components/Px.astro";
import TradingChart, { type View } from "../../../components/TradingChart.astro";
import { change, contests, countdown, phaseOf, positionParts, shortDid, signed, tabs, tieGroups, type Contest } from "../../../lib/contests";

export function getStaticPaths() {
  return contests().map((c) => ({ params: { id: c.id }, props: { contest: c } }));
}
interface Props { contest: Contest }
const { contest: c } = Astro.props;
const phase = phaseOf(c);
const s = c.series ?? [];
const lb = c.leaderboard;
const num = (v: string | null | undefined) => (v === null || v === undefined ? null : Number(v));
const has = (k: keyof (typeof s)[number]) => s.some((p) => p[k] !== undefined && p[k] !== null);
const compact = (n: number) => (n >= 1e6 ? `${+(n / 1e6).toFixed(2)}M` : n >= 1e4 ? `${+(n / 1e3).toFixed(1)}k` : n.toLocaleString("en-US"));

const views: View[] = [];
if (s.length) {
  views.push({ id: "price", label: "Price", series: [
    { label: "NVDA · Hyperliquid", token: "--color-accent", values: s.map((p) => num(p.price)) },
    ...(has("global") ? [{ label: "Agents' price", token: "--color-warning", values: s.map((p) => num(p.global)) }] : []),
  ] });
  if (has("top")) views.push({ id: "scores", label: "Top scores", series: [
    { label: "#1 score", token: "--color-accent", values: s.map((p) => num(p.top)) },
    ...(has("line") ? [{ label: "Prize line", token: "--color-warning", values: s.map((p) => num(p.line)), dashed: true }] : []),
  ] });
  if (has("long")) views.push({ id: "sides", label: "Long / Short", min: 0, series: [
    { label: "Long", token: "--color-accent", values: s.map((p) => p.long ?? null) },
    { label: "Short", token: "--color-down", values: s.map((p) => p.short ?? null) },
  ] });
  views.push(has("active")
    ? { id: "traders", label: "Traders", min: 0, series: [{ label: "Active traders", token: "--color-accent", values: s.map((p) => p.active ?? null) }] }
    : { id: "players", label: "Players", min: 0, series: [{ label: "Registered players", token: "--color-accent", values: s.map((p) => p.owners) }] });
}

const price = c.latest?.price;
const move = change(s[0]?.price, price);
const actives = s.map((p) => p.active).filter((v): v is number => v !== undefined);
const traders = c.ranking?.traders;
const hourAgo = actives.length > 12 ? actives[actives.length - 1] - actives[actives.length - 13] : undefined;
const groups = lb ? tieGroups(lb.rows) : [];
const withPosition = lb?.rows.some((r) => r.position !== undefined) ?? false;
const line = lb && lb.rows.length >= 3 ? lb.rows[2].pnl : undefined;
const prizeN = Number(c.prize.replace(/[^0-9]/g, ""));
const clock = phase === "live" ? { label: "Locks in", value: countdown(c.trading_lock_at) }
  : phase === "closed" && c.final_price_at ? { label: "Final price in", value: countdown(c.final_price_at) }
  : phase === "upcoming" ? { label: "Starts in", value: countdown(c.opening) } : { label: "Ended", value: "Final" };
const cells = [
  { icon: "chart-line", tone: "accent", label: "NVDA", value: price ? price : "–", delta: move, deltaTone: move?.startsWith("−") ? "text-down" : "text-accent" },
  { icon: "users", tone: "accent", label: "Active traders", value: traders !== undefined ? traders.toLocaleString("en-US") : "–",
    delta: hourAgo !== undefined ? `${hourAgo >= 0 ? "+" : "−"}${compact(Math.abs(hourAgo))} 1h` : undefined, deltaTone: "text-accent" },
  { icon: "crown", tone: "warning", label: "#1 score", value: lb?.rows[0] ? signed(lb.rows[0].pnl) : "–", delta: lb?.rows[0] ? "POLF" : undefined, deltaTone: "text-text-muted", valueTone: "text-accent" },
  { icon: "trophy", tone: "warning", label: "Prize · top 3", value: prizeN ? compact(prizeN) : c.prize, delta: "FLOP", deltaTone: "text-text-muted" },
  { icon: "hourglass", tone: "accent", label: clock.label, value: clock.value },
];
const tile = { accent: "bg-accent-soft text-accent", warning: "bg-warning-soft text-warning" } as const;
const current = tabs(c)[0].label;
---
<Base title={c.title} description={`${c.title}, live: price, active traders, the signed top list and a search for any DID.`}>
  <ContestHeader contest={c} current={current} />

  {c.latest ? (
    <ul class="mt-4 grid grid-cols-2 overflow-hidden rounded-xl border border-border bg-surface sm:grid-cols-3 lg:grid-cols-5">
      {cells.map((k, i) => (
        <li class:list={["flex items-center gap-3 border-border px-4 py-3.5", i > 0 && "border-t sm:border-t-0 lg:border-l", i === 4 && "col-span-2 sm:col-span-1"]}>
          <span class:list={["grid size-10 shrink-0 place-items-center rounded-lg", tile[k.tone as keyof typeof tile]]}><Px name={k.icon} size={24} /></span>
          <span class="grid min-w-0 gap-0.5">
            <span class="text-xs text-text-secondary">{k.label}</span>
            <span class="flex items-baseline gap-2 whitespace-nowrap">
              <span class:list={["font-mono text-xl font-semibold tabular-nums", k.valueTone ?? "text-text"]}>{k.value}</span>
              {k.delta && <span class:list={["font-mono text-xs", k.deltaTone]}>{k.delta}</span>}
            </span>
          </span>
        </li>
      ))}
    </ul>
  ) : (
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="grid gap-1 rounded-xl border border-border bg-surface p-4"><p class="text-sm text-text-secondary">Winner</p><p class="text-xl">{c.winner}</p><p class="text-sm text-text-muted">{c.winner_source}</p></div>
      <div class="grid gap-1 rounded-xl border border-border bg-surface p-4"><p class="text-sm text-text-secondary">Prize</p><p class="text-xl">{c.prize}</p></div>
      <div class="grid gap-1 rounded-xl border border-border bg-surface p-4"><p class="text-sm text-text-secondary">Rules</p><a href={c.rules} class="text-link">Rules on GitHub</a></div>
    </div>
  )}

  {(views.length > 0 || c.ranking) && (
    <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
      {views.length > 0 && <TradingChart views={views} at={s.map((p) => p.at)}
        summary={`NVDA price at each referee update, from ${s[0].price ?? "no price"} to ${price ?? "no price"}.`} />}

      {c.ranking && (
        <section aria-labelledby="find-title" class="grid content-start gap-3 rounded-xl border border-border bg-surface p-4 sm:p-5"
          data-find-did data-url={c.ranking.file} data-traders={c.ranking.traders} data-line={line}
          data-lock={phase === "live" ? countdown(c.trading_lock_at) : undefined}>
          <h2 id="find-title" class="flex items-center gap-2 font-semibold"><Px name="search" size={24} class="text-accent" />Find my DID</h2>
          <form class="flex min-h-11 items-center gap-2 rounded-lg border border-border-strong bg-bg pr-1.5 pl-3" data-find-form>
            <label for="find-input" class="sr-only">Your did:key</label>
            <input id="find-input" name="did" autocomplete="off" spellcheck="false" placeholder="did:key:z6Mk…" class="min-w-0 flex-1 bg-transparent font-mono text-sm text-text outline-none placeholder:text-text-muted" />
            <button type="submit" class="min-h-8 rounded-md bg-accent px-3 text-sm font-semibold text-on-accent">Find</button>
          </form>
          <div data-find-result aria-live="polite"></div>
          <noscript><p class="text-sm text-text-muted">Searching needs JavaScript. The full ranking is also a file: <a class="text-link" href={c.ranking.file}>ranking.json</a>.</p></noscript>
        </section>
      )}
    </div>
  )}

  {lb && (
    <section aria-labelledby="top-title" class="mt-4 overflow-hidden rounded-xl border border-border bg-surface">
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3.5 sm:px-5">
        <h2 id="top-title" class="flex items-center gap-2 font-semibold"><Px name="trending-up" size={24} class="text-accent" />Top traders
          <Help term="Top traders" text="The referee's signed top list at its latest update, each score recomputed by us from the signed trades. Keys with equal scores share the places they span." /></h2>
        {traders !== undefined && <p class="font-mono text-xs text-text-muted">{traders.toLocaleString("en-US")} active</p>}
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-raised text-xs text-text-muted">
            <tr>
              <th scope="col" class="w-16 px-4 py-2 font-semibold sm:px-5">#</th>
              <th scope="col" class="px-4 py-2 font-semibold">Trader</th>
              <th scope="col" class="px-4 py-2 text-right font-semibold">Score</th>
              {withPosition && <th scope="col" class="hidden px-4 py-2 font-semibold sm:table-cell">Position</th>}
              <th scope="col" class="w-12 px-4 py-2 sm:px-5"><span class="sr-only">Our check</span></th>
            </tr>
          </thead>
          <tbody>
            {groups.map(({ row: r, tied }, k) => {
              const pos = positionParts(r.position);
              const side = pos?.side === "Short" ? "text-down" : pos?.side === "Flat" ? "text-text-muted" : "text-accent";
              return (
                <tr class:list={["border-t border-border", k < 3 && "bg-accent-soft/40"]}>
                  <td class="px-4 py-3 sm:px-5">
                    <span class:list={["inline-flex items-center gap-1.5 font-mono", k < 3 ? "font-bold text-text" : "text-text-secondary"]}>
                      {r.rank === 1 && <Px name="crown" size={12} class="text-warning" label="First place" />}{r.rank}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-flex flex-wrap items-center gap-2">
                      <span class="font-mono">{shortDid(r.did)}</span>
                      {tied > 0 && <span class="rounded-md border border-border bg-surface-raised px-1.5 py-0.5 text-xs font-semibold text-text-secondary">{tied} tied</span>}
                    </span>
                    {pos && <span class:list={["mt-0.5 block font-mono text-xs sm:hidden", side]}>{pos.side} {pos.detail}</span>}
                  </td>
                  <td class="px-4 py-3 text-right font-mono font-semibold whitespace-nowrap text-accent tabular-nums">{signed(r.pnl)}</td>
                  {withPosition && <td class:list={["hidden px-4 py-3 font-mono text-xs whitespace-nowrap sm:table-cell", side]}>{pos ? `${pos.side} ${pos.detail}`.trim() : ""}</td>}
                  <td class="px-4 py-3 text-right sm:px-5">
                    {r.check === "match" && <Px name="check" size={24} class="inline text-accent" label="Checked: our recount finds the same score" />}
                    {r.check === "pending" && <Px name="hourglass" size={12} class="inline text-text-muted" label="Not checked yet" />}
                    {r.check === "differs" && <Px name="warning-diamond" size={12} class="inline text-warning" label="Our recount finds a different score" />}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}
  {c.ranking && <script>import "../../../scripts/find-did.ts";</script>}
</Base>
