---
// Rankings (beta, unofficial): paused. The page ranked every DID across FLOP Labs contests next to its
// Close Call rank from our recount; until that recount can be proved against the referee's signed
// hashes, it shows no ranking at all, only this notice (Ben, 2026-09-29: never show a wrong figure).
// The route and its place in the navigation stay, so old links still land here.
import Base from "../../layouts/Base.astro";
import Px from "../../components/Px.astro";
---
<Base title="Rankings (beta, paused)" description="Room Census rankings are paused: they return once our recount is proved.">
  <div class="grid gap-1.5">
    <h1 class="flex items-center gap-3 text-3xl font-medium tracking-tight sm:text-4xl">Rankings
      <span class="rounded-md border border-warning-border bg-warning-soft px-2 py-0.5 font-mono text-xs font-bold tracking-widest text-warning">BETA</span></h1>
    <p class="text-sm text-text-muted">Unofficial. Made by Room Census, not by FLOP Labs.</p>
  </div>

  <p class="mt-4 flex items-center gap-3 rounded-xl border border-border bg-surface px-5 py-4 text-sm" data-rankings-paused role="status">
    <Px name="hourglass" size={24} class="shrink-0 text-warning" />
    <span><span class="font-semibold">Paused: the ranking returns once our recount is proved.</span>
      <span class="text-text-muted">Meanwhile, each contest shows the top list its referee signs.</span>
      <a class="text-link" href="/contests/">Contests</a></span>
  </p>
</Base>
