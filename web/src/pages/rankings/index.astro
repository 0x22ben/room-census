---
// Rankings (beta, unofficial, Pencil mockups wDNMc and l67lZQ): every DID by the FLOP that FLOP Labs
// awarded it across its contests, from the payout lists FLOP Labs published. A podium (one wide step
// when the first place is shared, as by Sonnet's winning team), the first hundred with why each DID was
// paid, and a search that pins any DID; saved DIDs (the top bar's switcher) are pinned too.
import Base from "../../layouts/Base.astro";
import Help from "../../components/Help.astro";
import PixelAvatar from "../../components/PixelAvatar.astro";
import Px from "../../components/Px.astro";
import { contest, ranksOf, shortDid, signed } from "../../lib/contests";
import { standingsView } from "../../lib/standings.mjs";
import { dateTimeUtc } from "../../lib/format";
import { champions, ordinal, rankings, type RankedDid } from "../../lib/rankings";
import { eachLabel, winnersOf } from "../../lib/winners.mjs";

const { paid, pending, rows } = rankings();
const champ = champions();
// the first hundred lines; a long tie shows its first three, then how many more share that rank
type Line = { row: RankedDid } | { more: number; rank: number; flop: number };
const lines: Line[] = [];
for (let i = 0, shown = 0; i < rows.length && shown < 100;) {
  let j = i;
  while (j < rows.length && rows[j].rank === rows[i].rank) j++;
  const group = rows.slice(i, j);
  const keep = group.length > 10 ? group.slice(0, 3) : group.slice(0, 100 - shown);
  keep.forEach((row) => lines.push({ row }));
  if (keep.length < group.length) lines.push({ more: group.length - keep.length, rank: rows[i].rank, flop: rows[i].flop });
  shown += keep.length;
  i = j;
}
const top = lines.flatMap((l) => ("row" in l ? [l.row] : []));
const columns = 7 + paid.length + pending.length;
const label = (r: RankedDid) => paid.filter((c) => r.roles[c.id]).map((c) => c.labels[r.roles[c.id]]);
const close = contest("close-1");
// Close Call has ended: once the referee has posted its final standings, they replace the ranks of the last
// update (the referee lists its first 25 places only, so the other keys show no Close Call rank)
const fin = close?.standings ? standingsView(close.standings) : undefined;
const finalRank = new Map(fin ? [...fin.winners, ...fin.next].map((p) => [p.did, p.rank] as const) : []);
const live = close ? ranksOf(close, top.map((r) => r.did)) : new Map();
const n = (v: number) => v.toLocaleString("en-US");
// the general ranking: the winners of each contest side by side, each in its own unit (nothing is added up)
const general = paid.map((c) => ({ c, title: contest(c.id)?.title ?? c.title, w: winnersOf(c.payouts, c.roles) }));
const closePlaces = fin ? [...fin.winners, ...fin.next] : [];
const FIRST = 10;
const tied = (rank: number) => rows.filter((r) => r.rank === rank).length;
const podium = [top[1], top[0], top[2]].filter(Boolean);
const tone = ["#e3b341", "#c3cbd6", "#cd8a55"];
const at = (r: { rank: number }) => Math.min(2, r.rank - 1);
const height = (i: number) => (i === 1 ? "h-44" : i === 0 ? "h-32" : "h-24");
const traderHref = (did: string) => (live.has(did) ? `/contests/close-1/did/?k=${did}` : undefined);
---
<Base title="Rankings: every DID by the FLOP it won (beta)" description="Unofficial rankings of every DID across FLOP Labs contests, by the FLOP FLOP Labs awarded. Beta, made by Room Census, not by FLOP Labs.">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="grid gap-1.5">
      <h1 class="flex items-center gap-3 text-3xl font-medium tracking-tight sm:text-4xl">Rankings
        <span class="rounded-md border border-warning-border bg-warning-soft px-2 py-0.5 font-mono text-xs font-bold tracking-widest text-warning">BETA</span></h1>
      <p class="flex items-center gap-2 text-sm text-text-muted">Unofficial. Made by Room Census, not by FLOP Labs.
        <Help term="Rankings" text="Counts only the FLOP that FLOP Labs awarded, from the payout lists it published and its referee signed. Close Call's 1,000,000 FLOP are added once FLOP Labs publishes who gets what." /></p>
    </div>
    <div class="flex flex-wrap gap-1" role="group" aria-label="Contests">
      {[["all", "All contests"], ...paid.map((c) => [c.id, c.title]), ...pending.map((p) => [p.id, p.title])].map(([id, label], i) => (
        <button type="button" data-filter={id} aria-pressed={i === 0 ? "true" : "false"}
          class="inline-flex min-h-9 items-center rounded-lg border border-transparent px-3 text-sm text-text-secondary aria-pressed:border-border-strong aria-pressed:bg-surface-raised aria-pressed:font-semibold aria-pressed:text-text">{label}</button>
      ))}
    </div>
  </div>

  <p class="mt-4 hidden items-center gap-3 rounded-xl border border-border bg-surface px-5 py-4 text-sm" data-pending>
    <Px name="hourglass" size={24} class="text-warning" />
    {fin ? (
      <span class="grid gap-2">
        <span><span class="font-semibold">Close Call has ended: the referee's final standings name the top 3.</span> <span class="text-text-muted">Their share of the {close!.prize} is added here once FLOP Labs publishes who gets what.</span>
          <a class="text-link" href="/contests/close-1/">Final standings</a></span>
        <span class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs" data-close-winners>
          {fin.winners.map((w) => (
            <span><span class="text-text-muted">#{w.rank}</span> <a class="text-text" href={`/contests/close-1/did/?k=${w.did}`} title={w.did}>{shortDid(w.did)}</a> <span class="text-accent">{signed(w.score)}</span></span>
          ))}
        </span>
      </span>
    ) : (
      <span><span class="font-semibold">Close Call: 1,000,000 FLOP for the top 3.</span> <span class="text-text-muted">Added here once FLOP Labs publishes who gets what, after 4 October.</span>
        <a class="text-link" href="/contests/close-1/">Live ranking</a></span>
    )}
  </p>

  <section aria-labelledby="general-title" class="mt-4 grid gap-4" data-general>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="general-title" class="text-xl font-semibold">General ranking</h2>
      <p class="text-sm text-text-muted">The winners of each contest. Each keeps its own unit: nothing is added up.</p>
    </div>
    <div class="grid items-start gap-4 lg:grid-cols-2">
      {close && (
        <article class="overflow-hidden rounded-xl border border-border bg-surface" data-general-contest="close-1">
          <header class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-border px-4 py-3.5 sm:px-5">
            <h3 class="font-semibold">{close.title}</h3>
            <p class="font-mono text-xs text-text-muted">{fin ? `Final standings · POLF · final price ${fin.price}` : "Final standings not published yet"}</p>
          </header>
          {fin ? (
            <>
              <ol aria-label="The first places of Close Call">
                {closePlaces.slice(0, FIRST).map((p) => (
                  <li class:list={["flex items-center justify-between gap-3 px-4 py-2.5 sm:px-5", p.rank > 1 && "border-t border-border"]} data-place={p.rank}>
                    <span class="flex min-w-0 items-center gap-3">
                      <span class="w-8 font-mono text-sm font-bold text-text">#{p.rank}</span>
                      <a class="font-mono text-sm text-text" href={`/contests/close-1/did/?k=${p.did}`} title={p.did}>{shortDid(p.did)}</a>
                      {p.rank <= fin.winners.length && <span class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-semibold text-accent">Prize place</span>}
                    </span>
                    <span class="font-mono font-semibold whitespace-nowrap text-accent tabular-nums">{signed(p.score)} POLF</span>
                  </li>
                ))}
              </ol>
              {closePlaces.length > FIRST && (
                <details class="border-t border-border">
                  <summary class="cursor-pointer px-4 py-3 text-sm font-semibold sm:px-5">Places {FIRST + 1} to {closePlaces.length}</summary>
                  <ol aria-label="The next places of Close Call">
                    {closePlaces.slice(FIRST).map((p) => (
                      <li class="flex items-center justify-between gap-3 border-t border-border px-4 py-2.5 sm:px-5" data-place={p.rank}>
                        <span class="flex min-w-0 items-center gap-3">
                          <span class="w-8 font-mono text-sm text-text-secondary">#{p.rank}</span>
                          <a class="font-mono text-sm text-text" href={`/contests/close-1/did/?k=${p.did}`} title={p.did}>{shortDid(p.did)}</a>
                        </span>
                        <span class="font-mono whitespace-nowrap text-text-secondary tabular-nums">{signed(p.score)} POLF</span>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
              <p class="border-t border-border px-4 py-3 text-xs text-text-muted sm:px-5">Signed by the referee on {dateTimeUtc(fin.postedAt)}. The referee lists its first {closePlaces.length} places. The three prize places share {close.prize} once FLOP Labs publishes who gets what; their FLOP is added to the ranking below at that point. <a class="text-link" href="/contests/close-1/">Final standings</a></p>
            </>
          ) : (
            <p class="px-4 py-3.5 text-sm text-text-muted sm:px-5">The referee has not published its final standings yet. <a class="text-link" href="/contests/close-1/">Live ranking</a></p>
          )}
        </article>
      )}
      {general.map(({ c, title, w }) => (
        <article class="overflow-hidden rounded-xl border border-border bg-surface" data-general-contest={c.id}>
          <header class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-border px-4 py-3.5 sm:px-5">
            <h3 class="font-semibold">{title}</h3>
            <p class="font-mono text-xs text-text-muted">{n(w.total)} FLOP paid to {n(w.dids)} DIDs</p>
          </header>
          <ul aria-label={`Authors of the winning ${c.prize.toLowerCase()}`}>
            {w.authors.map((a, i) => (
              <li class:list={["flex items-center justify-between gap-3 px-4 py-2.5 sm:px-5", i > 0 && "border-t border-border"]} data-author={a.did}>
                <span class="flex min-w-0 items-center gap-3">
                  <span class="font-mono text-sm text-text" title={a.did}>{shortDid(a.did)}</span>
                  <span class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-semibold text-accent">{c.labels.contributor}</span>
                </span>
                <span class="font-mono font-semibold whitespace-nowrap text-accent tabular-nums">{n(a.flop)} FLOP</span>
              </li>
            ))}
          </ul>
          <p class="border-t border-border px-4 py-3 text-sm text-text-secondary sm:px-5">{n(w.voters.count)} voters who chose it, {eachLabel(w.voters)}.</p>
          <p class="border-t border-border px-4 py-3 text-xs text-text-muted sm:px-5">From FLOP Labs' payout list, byte for byte the one the referee signed ({c.receipt}).</p>
        </article>
      ))}
    </div>
  </section>

  <div class="mt-8 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="text-xl font-semibold">FLOP awarded so far</h2>
    <p class="text-sm text-text-muted">Only the FLOP that FLOP Labs has actually paid counts here.</p>
  </div>

  <section aria-label="Podium" class="relative mt-3 overflow-hidden rounded-2xl border border-border bg-linear-to-b from-[#0f1220] to-bg px-4 pt-6 sm:px-10" data-podium>
    <p class="text-center font-['Silkscreen'] text-2xl font-bold tracking-[0.35em] text-text">HIGH SCORES</p>
    {champ.rows.length > 1 ? (
      <div class="mt-4 grid justify-items-center gap-4">
        <Px name="crown" size={24} class="text-[#e3b341]" label="First place" />
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-4">
          {champ.rows.slice(0, 8).map((r) => (
            <div class="grid w-32 justify-items-center gap-1.5">
              <PixelAvatar did={r.did} size={64} class="ring-2 ring-border" />
              <span class="font-mono text-xs text-text-secondary">{shortDid(r.did)}</span>
              <span class="flex items-baseline gap-1.5"><span class="font-mono text-xl font-bold" data-tone="0">{n(r.flop)}</span><span class="font-['Silkscreen'] text-[10px] text-text-muted">FLOP</span></span>
            </div>
          ))}
        </div>
        <div class="w-full max-w-xl">
          <div class="h-4" data-top="0"></div>
          <div class="grid w-full place-items-center content-center gap-1.5 border-x-2 px-3 pt-5 pb-8 text-center" data-front="0">
            <span class="font-['Silkscreen'] text-4xl font-bold tracking-widest" data-tone="0">1ST</span>
            {champ.team
              ? <>
                  <span class="font-['Silkscreen'] text-sm tracking-[0.2em] uppercase" data-tone="0">{champ.team.name}</span>
                  <span class="font-['Silkscreen'] text-[10px] tracking-[0.15em] text-text-muted uppercase">{champ.team.prize} · {n(champ.team.flop)} FLOP shared by {champ.rows.length}</span>
                </>
              : <span class="font-['Silkscreen'] text-[11px] tracking-[0.2em]" data-tone="0">{champ.rows.length} TIED</span>}
          </div>
        </div>
      </div>
    ) : (
      <div class="mt-6 flex items-end justify-center gap-0">
        {podium.map((r, i) => (
          <div class="grid w-36 justify-items-center gap-2 sm:w-64">
            {r.rank === 1 ? <Px name="crown" size={24} class="text-[#e3b341]" label="First place" /> : <span class="h-6"></span>}
            <PixelAvatar did={r.did} size={i === 1 ? 88 : 64} class="ring-2 ring-border" />
            <span class="font-mono text-xs text-text-secondary">{shortDid(r.did)}</span>
            <span class="flex items-baseline gap-1.5"><span class="font-mono text-2xl font-bold" data-tone={at(r)}>{n(r.flop)}</span><span class="font-['Silkscreen'] text-xs text-text-muted">FLOP</span></span>
            <div class="w-full">
              <div class="h-4" data-top={at(r)}></div>
              <div class:list={["grid w-full place-items-center content-center gap-1 border-x-2", height(i)]} data-front={at(r)}>
                <span class="font-['Silkscreen'] text-3xl font-bold tracking-widest sm:text-4xl" data-tone={at(r)}>{ordinal(r.rank).toUpperCase()}</span>
                <span class="font-['Silkscreen'] text-[11px] tracking-[0.2em]" data-tone={at(r)}>{tied(r.rank) > 1 ? `${tied(r.rank)} TIED` : r.rank === 1 ? "CHAMPION" : "PODIUM"}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <section aria-labelledby="board-title" class="mt-4 overflow-hidden rounded-xl border border-border bg-surface" data-rankings data-url="/rankings/ranking.json">
    <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-5">
      <h2 id="board-title" class="flex items-center gap-2 font-semibold"><Px name="fire" size={24} class="text-down" />Leaderboard
        <span class="font-mono text-xs font-normal text-text-muted">{n(rows.length)} DIDs</span></h2>
      <form class="flex min-h-11 w-full items-center gap-2 rounded-lg border border-border-strong bg-bg pr-1.5 pl-3 sm:w-96" data-rank-form>
        <label for="rank-input" class="sr-only">A did:key</label>
        <Px name="search" size={12} class="text-text-muted" />
        <input id="rank-input" autocomplete="off" spellcheck="false" placeholder="Find my rank: did:key:z6Mk…" class="min-w-0 flex-1 bg-transparent font-mono text-sm outline-none placeholder:text-text-muted" />
        <button type="submit" class="min-h-8 rounded-md bg-accent px-3 text-sm font-semibold text-on-accent">Find</button>
      </form>
    </div>
    <p class="px-5 pb-3 text-sm" data-rank-result aria-live="polite"></p>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-surface-raised text-xs text-text-muted">
          <tr>
            <th scope="col" class="w-14 px-4 py-2 sm:px-5">#</th>
            <th scope="col" class="px-4 py-2" colspan="2">DID</th>
            <th scope="col" class="px-4 py-2 text-right">FLOP</th>
            <th scope="col" class="hidden px-4 py-2 sm:table-cell">Contests</th>
            <th scope="col" class="hidden px-4 py-2 md:table-cell">Role</th>
            {paid.map((c) => <th scope="col" class="hidden px-4 py-2 lg:table-cell">{c.title}</th>)}
            {pending.map((p) => <th scope="col" class="hidden px-4 py-2 lg:table-cell">{p.title}</th>)}
            <th scope="col" class="w-8 pr-4 sm:pr-5"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody data-pinned></tbody>
        <tbody>
          {lines.map((l) => {
            if (!("row" in l)) return (
              <tr class="border-t border-border" data-more>
                <td colspan={columns} class="px-4 py-3 font-mono text-xs text-text-muted sm:px-5">+ {n(l.more)} more DIDs at #{n(l.rank)} · {n(l.flop)} FLOP each</td>
              </tr>
            );
            const r = l.row;
            const href = traderHref(r.did);
            const cc = fin ? (finalRank.has(r.did) ? { rank: finalRank.get(r.did)! } : undefined) : live.get(r.did);
            return (
              <tr class:list={["relative border-t border-border", href && "transition-colors hover:bg-surface-raised"]} data-did={r.did}>
                <td class:list={["px-4 py-2.5 font-mono sm:px-5", r.rank === 1 ? "font-bold text-[#e3b341]" : "text-text-secondary"]}>{r.rank}</td>
                <td class="w-9 py-2.5 pl-4"><PixelAvatar did={r.did} size={26} /></td>
                <td class="px-2 py-2.5">
                  {href
                    ? <a class="font-mono text-text no-underline outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline" href={href}>{shortDid(r.did)}</a>
                    : <span class="font-mono">{shortDid(r.did)}</span>}
                </td>
                <td class:list={["px-4 py-2.5 text-right font-mono font-bold whitespace-nowrap", r.rank === 1 ? "text-[#e3b341]" : "text-accent"]}>{n(r.flop)}</td>
                <td class="hidden px-4 py-2.5 font-mono text-text-secondary sm:table-cell">{Object.keys(r.by).length}</td>
                <td class="hidden px-4 py-2.5 md:table-cell"><span class="flex flex-wrap gap-1">{label(r).map((t) => (
                  <span class:list={["rounded-md border px-2 py-0.5 text-xs font-semibold whitespace-nowrap", r.rank === 1 ? "border-[#6b5a1e] bg-[#2a2410] text-[#e3b341]" : "border-border-strong bg-surface-raised text-text-secondary"]}>{t}</span>
                ))}</span></td>
                {paid.map((c) => <td class="hidden px-4 py-2.5 lg:table-cell">{r.by[c.id] ? <span class="rounded-md bg-accent-soft px-2 py-0.5 font-mono text-xs font-semibold text-accent">{n(r.by[c.id])}</span> : <span class="text-text-muted">–</span>}</td>)}
                {pending.map(() => <td class="hidden px-4 py-2.5 lg:table-cell">{cc ? <span class="rounded-md bg-surface-raised px-2 py-0.5 font-mono text-xs text-text-secondary">#{n(cc.rank)}</span> : <span class="text-text-muted">–</span>}</td>)}
                <td class="pr-4 text-right text-text-muted sm:pr-5">{href && <Px name="chevron-right" size={12} class="inline" />}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
  <script>import "../../scripts/rankings.ts";</script>
</Base>
