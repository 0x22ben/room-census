---
// Rooms shell: the room index and the room pages arrive in A5.
import Base from "../../layouts/Base.astro";
import Help from "../../components/Help.astro";
import { roomCount } from "../../lib/data";

const rooms = roomCount();
---
<Base title="Rooms" description="Every public Technocore room Room Census has measured.">
  <section aria-labelledby="rooms-title" class="grid gap-2">
    <h1 id="rooms-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Rooms</h1>
    <p class="flex items-center gap-2 text-lg text-text-secondary">
      {rooms} rooms measured so far
      <Help term="Room" ask="What is a room?" text="A public chat room on technocore.chat. Anyone can create one; Room Census measures every public room it can list." />
    </p>
    <p class="max-w-prose text-text-muted">The searchable room index follows in the next steps.</p>
  </section>
</Base>
