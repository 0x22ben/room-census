---
// My DID, laid out as the approved Pencil mockups (My DID, Create DID and its steps): create,
// protect and restore a Technocore identity, prepare a first signed message, and look up public
// activity. Everything runs in this browser. The secret key lives in the page's memory and leaves it
// only inside the encrypted recovery file the reader downloads; no key, password or recovery file is
// ever sent anywhere. The lookup reads the newest messages of each measured room from Technocore,
// keeps the ones this DID signed, and checks every signature locally; a message that names the DID
// without a valid signature is never counted.
import Base from "../layouts/Base.astro";
import Help from "../components/Help.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import BadgeCheck from "@lucide/astro/icons/badge-check";
import Check from "@lucide/astro/icons/check";
import CircleCheck from "@lucide/astro/icons/circle-check";
import Copy from "@lucide/astro/icons/copy";
import Download from "@lucide/astro/icons/download";
import EyeOff from "@lucide/astro/icons/eye-off";
import FileLock from "@lucide/astro/icons/file-lock";
import FolderOpen from "@lucide/astro/icons/folder-open";
import Info from "@lucide/astro/icons/info";
import KeyRound from "@lucide/astro/icons/key-round";
import Lock from "@lucide/astro/icons/lock";
import MessageSquare from "@lucide/astro/icons/message-square";
import RefreshCw from "@lucide/astro/icons/refresh-cw";
import Search from "@lucide/astro/icons/search";
import Send from "@lucide/astro/icons/send";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import TriangleAlert from "@lucide/astro/icons/triangle-alert";
import Upload from "@lucide/astro/icons/upload";
import { site } from "../lib/data";
import { DID_DISCLAIMER } from "../lib/patterns";
import { TECHNOCORE_CSP } from "../lib/site";
import { WINDOW } from "../lib/did-core.mjs";
import { MIN_PASSWORD, ROOMS, STARTERS } from "../lib/did-wallet.mjs";

const { latest, identity, rooms } = site();
// the rooms of the latest census, then the room where Room Census signs its own messages
const measured = latest.rooms.map((r) => r.room);
const ownRoomExtra = !measured.includes(identity.room);
const inspected = ownRoomExtra ? [...measured, identity.room] : measured;
const pages = [...rooms.keys()];
const kpi = "grid gap-1 rounded-lg border border-border bg-surface p-4";
const kpiLabel = "flex items-center gap-1.5 text-sm text-text-secondary";
const kpiValue = "font-mono text-2xl font-bold";
// the mockup's building blocks
const card = "grid grid-cols-[minmax(0,1fr)] gap-4 rounded-xl border border-border bg-surface p-5 sm:p-7";
const tile = "grid size-12 place-items-center rounded-lg border border-accent-border bg-accent-soft text-accent";
const warnTile = "grid size-12 place-items-center rounded-lg border border-warning-border bg-warning-soft text-warning";
const title = "text-xl font-semibold tracking-tight outline-none sm:text-2xl";
const lede = "text-text-secondary";
const primary = "inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-accent px-5 font-semibold text-on-accent disabled:cursor-not-allowed disabled:opacity-50";
const secondary = "inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-lg border border-border-strong px-4 text-sm font-semibold text-text disabled:cursor-not-allowed disabled:opacity-50";
const input = "min-h-12 w-full min-w-0 rounded-lg border border-border-strong bg-bg px-3.5 text-base text-text";
const labelRow = "flex items-center gap-2 text-sm font-semibold";
const foot = "flex items-start gap-2 text-sm text-text-muted";
const alert = "text-sm font-semibold text-warning empty:hidden";
const good = "flex items-center gap-2.5 rounded-lg border border-accent-border bg-accent-soft px-4 py-3 text-sm font-semibold";
const warn = "flex items-center gap-2.5 rounded-lg border border-warning-border bg-warning-soft px-4 py-3 text-sm font-semibold";
const row = "flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border py-3 text-sm";
const rowKey = "text-text-secondary";
const rowValue = "font-mono break-all text-right";
const steps = ["Create", "Protect", "Write", "Publish"];
---
<Base title="My DID" csp={TECHNOCORE_CSP} local description="Create, protect and restore a Technocore identity in your browser, prepare a first signed message, and look up public activity.">
  <div class="mx-auto grid w-full max-w-3xl grid-cols-[minmax(0,1fr)] gap-6">
    <header class="grid justify-items-center gap-2 pt-4 text-center">
      <p class="flex items-center gap-2 font-mono text-xs font-semibold tracking-widest text-accent uppercase">
        Technocore identity
        <Help term="DID" id="help-did-intro" ask="What is a DID?" text="Your public name on Technocore. A secret key controls it: whoever holds the key can sign as you." />
      </p>
      <h1 id="did-title" data-page-title class="text-3xl font-medium tracking-tight sm:text-4xl">My DID</h1>
      <p class="text-text-secondary">Your DID is a public identifier controlled by a private recovery file.</p>
    </header>

    <p data-wizard-noscript class="text-center text-text-muted">Creating or restoring an identity needs JavaScript. It runs only in this browser.</p>
    <p data-framed hidden class="text-center font-semibold text-warning">This page is shown inside another site. Open roomcensus.xyz/did/ directly to create or restore a DID.</p>

    <div data-wizard hidden class="grid grid-cols-[minmax(0,1fr)] gap-6">
      <ol data-stepper hidden aria-label="Steps" class="flex items-center gap-2 text-sm sm:gap-3">
        {steps.map((s, i) => (
          <li data-step={i} data-step-label={s} class="group flex min-w-0 items-center gap-2 text-text-muted last:flex-none sm:flex-1 aria-[current=step]:font-semibold aria-[current=step]:text-text data-[done]:text-text">
            <span class="grid size-8 shrink-0 place-items-center rounded-full border border-border-strong font-mono text-xs group-aria-[current=step]:border-accent group-aria-[current=step]:text-accent group-data-[done]:border-accent group-data-[done]:bg-accent group-data-[done]:text-on-accent">
              <span class="group-data-[done]:hidden">{i + 1}</span>
              <Check size={16} aria-hidden="true" class="hidden group-data-[done]:block" />
            </span>
            <span class="hidden sm:inline">{s}</span><span class="sr-only sm:hidden">{s}</span>
            {i < steps.length - 1 && <span aria-hidden="true" class="hidden h-px flex-1 bg-border-strong group-data-[done]:bg-accent sm:block"></span>}
          </li>
        ))}
      </ol>
      <p data-step-now hidden aria-hidden="true" class="-mt-3 text-center text-sm font-semibold sm:hidden"></p>

      <!-- landing: the two ways in, as the My DID mockup -->
      <div data-panel="start" class="grid gap-4 md:grid-cols-2">
        <div class={card}>
          <span class={tile}><KeyRound size={22} aria-hidden="true" /></span>
          <h2 class="text-lg font-semibold">Create a new DID</h2>
          <p class={lede}>Generated in this browser. Nothing secret leaves your device unencrypted.</p>
          <button type="button" data-action="begin" class={primary}>Create my DID <ArrowRight size={18} aria-hidden="true" /></button>
        </div>
        <div class={card}>
          <span class={tile}><Upload size={22} aria-hidden="true" /></span>
          <h2 class="text-lg font-semibold">I already have a DID</h2>
          <p class={lede}>Open your recovery file and enter your passphrase.</p>
          <button type="button" data-action="begin-restore" class={secondary}><FolderOpen size={18} aria-hidden="true" /> Restore my DID</button>
        </div>
      </div>

      <!-- what Room Census can see: shown on the landing, before anything is created -->
      <section data-sees aria-labelledby="sees-title" class={card}>
        <h2 id="sees-title" class="text-lg font-semibold">What Room Census can see</h2>
        <div>
          <div class={row}><span class={rowKey}>Your DID and the messages you publish</span><span class={rowValue}>public</span></div>
          <div class={row}><span class={rowKey}>Your private key</span><span class={rowValue}>held by this tab in memory, saved only encrypted</span></div>
          <div class={row}><span class={rowKey}>Your passphrase and recovery file</span><span class={rowValue}>never sent anywhere</span></div>
        </div>
        <p class={foot}><Info size={16} aria-hidden="true" class="mt-0.5 shrink-0" />This site is static files: it has no server that could receive a key, a passphrase or a file.</p>
      </section>

      <!-- step 1: create (mockup "Create DID, step 1") -->
      <section data-panel="create" hidden class={card} aria-labelledby="create-title">
        <span class={tile}><KeyRound size={22} aria-hidden="true" /></span>
        <h2 id="create-title" tabindex="-1" class={title}>Create an identity on this device</h2>
        <p class={lede}>Room Census generates a new DID in this browser. Nothing secret is sent to us or to anyone.</p>
        <ul class="grid gap-3 text-sm">
          <li class="flex items-center gap-3"><span class="grid size-7 place-items-center rounded-md bg-accent-soft text-accent"><ShieldCheck size={16} aria-hidden="true" /></span>Your private key stays on this device, inside the encrypted file you save</li>
          <li class="flex items-center gap-3"><span class="grid size-7 place-items-center rounded-md bg-accent-soft text-accent"><FileLock size={16} aria-hidden="true" /></span>You will create an encrypted recovery file</li>
          <li class="flex items-center gap-3"><span class="grid size-7 place-items-center rounded-md bg-accent-soft text-accent"><MessageSquare size={16} aria-hidden="true" /></span>We will guide you to publish your first message</li>
        </ul>
        <button type="button" data-action="create" class={primary}>Create my DID <ArrowRight size={18} aria-hidden="true" /></button>
        <p data-error="create" role="alert" class={alert}></p>
        <p class={`${foot} justify-center`}><EyeOff size={16} aria-hidden="true" class="mt-0.5 shrink-0" />No account · no email · no tracking</p>
      </section>

      <!-- restore -->
      <section data-panel="restore" hidden class={card} aria-labelledby="restore-title">
        <span class={tile}><FolderOpen size={22} aria-hidden="true" /></span>
        <h2 id="restore-title" tabindex="-1" class={title}>Restore your DID</h2>
        <p class={lede}>Select your recovery file and enter its passphrase. It is opened here, on this device.</p>
        <form data-restore novalidate class="grid gap-4">
          <div class="grid gap-2">
            <span class={labelRow}>Recovery file</span>
            <label class="relative flex min-h-12 cursor-pointer items-center justify-between gap-3 rounded-lg border border-border-strong bg-bg py-1.5 pr-1.5 pl-3.5 focus-within:outline-2 focus-within:outline-focus">
              <span data-restore-file-name class="min-w-0 truncate font-mono text-sm text-text-muted">No file chosen</span>
              <span class="shrink-0 rounded-md bg-surface-raised px-3 py-2 text-sm font-semibold">Choose file</span>
              <input data-restore-file type="file" accept=".json,application/json" class="absolute inset-0 cursor-pointer opacity-0" aria-label="Recovery file" />
            </label>
          </div>
          <label class="grid gap-2"><span class={labelRow}>Passphrase</span><input data-restore-password type="password" autocomplete="current-password" spellcheck="false" autocapitalize="off" autocorrect="off" class={input} /></label>
          <button type="submit" data-action="restore" class={primary}>Restore my DID <ArrowRight size={18} aria-hidden="true" /></button>
          <p data-error="restore" role="alert" class={alert}></p>
        </form>
        <p class={foot}><Lock size={16} aria-hidden="true" class="mt-0.5 shrink-0" />The file and the passphrase are never sent anywhere.</p>
      </section>

      <!-- step 2: protect (mockup "Protect your identity"): one download, then straight to the message -->
      <section data-panel="protect" hidden class={card} aria-labelledby="protect-title">
        <span class={tile}><Lock size={22} aria-hidden="true" /></span>
        <h2 id="protect-title" tabindex="-1" class={title}>Protect your identity</h2>
        <p class={lede}>Choose a passphrase. It encrypts your recovery file on this device. Nobody can reset it for you.</p>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-bg px-4 py-3">
          <div class="grid min-w-0 gap-1">
            <p class="font-mono text-xs tracking-widest text-text-muted uppercase">Your public DID</p>
            <code data-did-value class="font-mono text-sm break-all"></code>
          </div>
          <button type="button" data-copy-did class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm font-semibold text-link"><Copy size={16} aria-hidden="true" /><span data-copy-label aria-live="polite">Copy</span></button>
        </div>
        <p class={warn}><TriangleAlert size={18} aria-hidden="true" class="shrink-0 text-warning" />For now your DID exists only in this tab. Without a recovery file, closing it loses the DID for good.</p>
        <form data-seal novalidate class="grid gap-4">
          <div class="grid gap-2">
            <label for="seal-password" class={labelRow}>Passphrase</label>
            <span class="flex gap-2"><input id="seal-password" data-seal-password type="password" autocomplete="new-password" spellcheck="false" autocapitalize="off" autocorrect="off" aria-describedby="seal-strength" class={input} /><button type="button" data-show="[data-seal-password]" aria-pressed="false" aria-label="Show the passphrase" class={secondary}>Show</button></span>
          </div>
          <div aria-hidden="true" class="grid grid-cols-4 gap-1.5">{[0, 1, 2, 3].map((i) => <span data-bar={i} class="h-1.5 rounded-full bg-border-strong data-[on]:bg-accent"></span>)}</div>
          <p id="seal-strength" data-strength class="text-sm text-text-muted">At least {MIN_PASSWORD} characters.</p>
          <label class="grid gap-2"><span class={labelRow}>Type it again</span><input data-seal-confirm type="password" autocomplete="new-password" spellcheck="false" autocapitalize="off" autocorrect="off" class={input} /></label>
          <button type="submit" class={primary}>Download recovery file <Download size={18} aria-hidden="true" /></button>
          <p data-error="seal" role="alert" class={alert}></p>
        </form>
        <p class={foot}><Info size={16} aria-hidden="true" class="mt-0.5 shrink-0" />Next, you write your first message. Your DID stays unlocked in this tab until you close it or lock it.</p>
      </section>

      <!-- steps 3 and 4: write and publish (mockup "Publish your first message") -->
      <section data-panel="message" hidden class={card} aria-labelledby="message-title">
        <span class={tile}><Send size={22} aria-hidden="true" /></span>
        <p data-saved-note hidden class={good}><CircleCheck size={18} aria-hidden="true" class="shrink-0 text-accent" />Your browser should now have saved the recovery file. Keep it and the passphrase in two separate safe places.</p>
        <h2 id="message-title" tabindex="-1" data-message-title class={title}>Publish your first message</h2>
        <p class={lede}>This writes to Technocore and cannot be undone. Check what becomes public.</p>
        <form data-compose novalidate class="grid gap-4">
          <fieldset class="grid gap-2">
            <legend class="mb-2 text-sm font-semibold">Room</legend>
            {ROOMS.map((r) => <label class="inline-flex min-h-11 items-center gap-2 font-mono text-sm"><input type="radio" name="room" value={r} class="size-4 accent-accent" /> {r}</label>)}
          </fieldset>
          <fieldset class="grid gap-2">
            <legend class="mb-2 text-sm font-semibold">Start from an idea</legend>
            <div class="flex flex-wrap gap-2">
              {STARTERS.map((st) => <button type="button" data-starter={st.id} data-starter-text={st.text} class={secondary}>{st.label}</button>)}
            </div>
          </fieldset>
          <p class="text-sm text-text-muted"><span class="font-semibold text-text-secondary">Tip from Coin Academy</span> (third-party guidance, not an official Flop Labs rule): publish a real first message about what you want to build, learn or test. Official contest requirements come only from the current Flop Labs rules.</p>
          <label class="grid gap-2">
            <span class={labelRow}>Message</span>
            <textarea data-message rows="3" maxlength="4096" aria-describedby="text-hint" class={`${input} py-3`}></textarea>
          </label>
          <p id="text-hint" class="text-sm text-text-muted">Replace every part in [brackets] with your own words. Line breaks become spaces.</p>
          <button type="submit" class={secondary}>Review the message</button>
          <p data-error="compose" role="alert" class={alert}></p>
        </form>
        <section data-preview hidden aria-labelledby="preview-title" class="grid gap-3 rounded-lg border border-border-strong bg-bg p-4">
          <h3 id="preview-title" tabindex="-1" class="font-semibold outline-none">Exactly what will be published</h3>
          <div>
            <div class={row}><span class={rowKey}>Room</span><span data-preview-room class={rowValue}></span></div>
            <div class={row}><span class={rowKey}>Signed by</span><span data-preview-did class={rowValue}></span></div>
          </div>
          <p data-preview-text class="rounded-md border border-border bg-surface p-3 break-words"></p>
          <p class={warn}><TriangleAlert size={18} aria-hidden="true" class="shrink-0 text-warning" />Public and permanent from your side: anyone can read and copy it, and you cannot edit or delete it.</p>
          <label class="inline-flex min-h-11 items-center gap-3"><input data-understand type="checkbox" class="size-5 accent-accent" /> I understand this message will be public and permanent.</label>
          <button type="button" data-action="publish" disabled class={primary}>Publish message <Send size={18} aria-hidden="true" /></button>
        </section>
        <p data-publish-status role="status" class="text-sm text-text-muted empty:hidden"></p>
      </section>

      <!-- outcome: a simple success, or an honest "not confirmed" / "not published" -->
      <section data-panel="outcome" hidden class={card} aria-labelledby="outcome-title">
        <span data-outcome-tile class={tile}><BadgeCheck data-icon-ok size={22} aria-hidden="true" /><TriangleAlert data-icon-warn size={22} aria-hidden="true" class="hidden" /></span>
        <h2 id="outcome-title" tabindex="-1" data-outcome-title class={title}></h2>
        <p data-outcome-lede class={lede}></p>
        <div>
          <div class={row}><span class={rowKey}>Public DID</span><code data-did-value class={rowValue}></code></div>
          <div class={row}><span class={rowKey}>Room</span><span data-out-room class={rowValue}></span></div>
        </div>
        <button type="button" data-action="view" hidden class={primary}>View in My DID <Search size={18} aria-hidden="true" /></button>
        <button type="button" data-action="another" hidden class={secondary}>Write another message</button>
        <button type="button" data-action="look" hidden class={primary}>Check Technocore again <RefreshCw size={18} aria-hidden="true" /></button>
        <button type="button" data-action="edit" hidden class={primary}>Edit and review again <ArrowRight size={18} aria-hidden="true" /></button>
        <p data-outcome-foot class={`${foot} empty:hidden`}></p>
        <details data-advanced class="rounded-lg border border-border bg-bg">
          <summary class="flex min-h-11 cursor-pointer items-center px-4 text-sm font-semibold">Advanced</summary>
          <div class="grid gap-3 border-t border-border px-4 pb-4">
            <div>
              <div class={row}><span class={rowKey}>Nonce</span><span data-out-nonce class={rowValue}></span></div>
              <div class={row}><span class={rowKey}>Stored</span><span data-out-stored class={rowValue}></span></div>
              <div class={row}><span class={rowKey}>Signature</span><span data-out-sig class={`${rowValue} text-xs`}></span></div>
            </div>
            <p class="text-sm text-text-muted">Technocore assigns the number and the time; the signature covers the room, the nonce and the text.</p>
            <button type="button" data-action="download-proof" class={secondary}><Download size={16} aria-hidden="true" /> Download technical receipt</button>
          </div>
        </details>
      </section>

      <div class="flex justify-center">
        <button type="button" data-action="start-over" hidden class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm font-semibold text-link"><Lock size={16} aria-hidden="true" /> Lock my DID</button>
      </div>
      <div data-confirm-over hidden class="grid gap-3 rounded-lg border border-warning-border bg-warning-soft p-4 text-sm">
        <p data-confirm-over-text class="font-semibold"></p>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-action="over-yes" class={secondary}>Lock and forget it in this tab</button>
          <button type="button" data-action="over-no" class={secondary}>Keep it unlocked</button>
        </div>
      </div>
    </div>

    <div data-lookup-area class="grid grid-cols-[minmax(0,1fr)] gap-4">
  <section aria-labelledby="lookup-title" class="grid grid-cols-[minmax(0,1fr)] gap-3 rounded-lg border border-border bg-surface p-5">
    <h2 id="lookup-title" class="flex items-center gap-2 text-lg font-medium">
      Look up a public DID
      <Help term="DID" ask="What is a DID?" text="A public identifier (did:key) that can sign Technocore messages. Only messages with a valid signature from this DID are counted." />
    </h2>
    <p data-did-noscript class="text-text-muted">The lookup needs JavaScript. It runs only in this browser.</p>
    <form data-did-form data-rooms={JSON.stringify(inspected)} data-measured={JSON.stringify(measured)} data-pages={JSON.stringify(pages)} data-census={latest.census} hidden novalidate class="grid grid-cols-[minmax(0,1fr)] gap-2">
      <label for="did-input" class="text-sm font-semibold">Public DID</label>
      <div class="flex flex-wrap gap-2">
        <input id="did-input" name="did" type="text" size="1" inputmode="text" autocomplete="off" autocapitalize="off" spellcheck="false"
          placeholder="did:key:z6Mk…" aria-describedby="did-hint did-error"
          class="min-h-11 min-w-0 flex-1 basis-64 rounded-md border border-border-strong bg-bg px-3 font-mono text-sm text-text placeholder:text-text-muted aria-invalid:border-warning" />
        <button type="submit" data-did-submit class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-border-strong px-4 text-sm font-semibold text-text disabled:cursor-wait disabled:opacity-60">
          <Search size={16} aria-hidden="true" /> Look up
        </button>
      </div>
      <p id="did-hint" class="text-sm text-text-muted">An Ed25519 did:key, starting with did:key:z6Mk.</p>
      <p id="did-error" data-did-error role="alert" class="text-sm font-semibold text-warning empty:hidden"></p>
    </form>
    <p class="text-sm text-text-muted">
      Inspected on each lookup: the newest {WINDOW} messages of each of the {measured.length} rooms in census #{latest.census}{ownRoomExtra && `, plus the ${identity.room} room where Room Census signs`}. In busy rooms that covers only seconds or minutes. Older messages, other rooms and private rooms are not inspected, so this shows recent activity found in the inspected rooms, not a complete history. It needs only the public DID, never a private key.
    </p>
  </section>

  <p class="flex items-start gap-2.5 rounded-md border border-border bg-surface px-4 py-2.5 text-sm text-text-secondary">
    <Info size={18} aria-hidden="true" class="mt-0.5 shrink-0" />
    <span>{DID_DISCLAIMER}</span>
  </p>

  <section data-did-result hidden aria-labelledby="result-title" class="grid grid-cols-[minmax(0,1fr)] gap-4">
    <div class="grid gap-1.5">
      <h2 id="result-title" tabindex="-1" data-did-heading class="text-2xl font-medium tracking-tight outline-none"></h2>
      <p data-did-for class="font-mono text-sm break-all text-text-secondary"></p>
      <p data-did-status role="status" class="text-sm text-text-muted"></p>
      <progress data-did-progress max="1" value="0" aria-label="Rooms read" class="h-1.5 w-full max-w-md accent-accent"></progress>
      <p data-did-count class="font-mono text-sm text-text-secondary tabular-nums empty:hidden"></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-did-cancel class="inline-flex min-h-11 cursor-pointer items-center rounded-md border border-border-strong px-4 text-sm font-semibold text-text">Stop</button>
        <button type="button" data-did-proof hidden class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-accent-border bg-accent-soft px-4 text-sm font-semibold text-text">
          <Download size={16} aria-hidden="true" class="text-accent" /> Download activity proof
        </button>
      </div>
    </div>

    <div data-did-summary hidden class="grid gap-3">
      <p data-did-meaning class="text-text-secondary"></p>
      <dl data-did-kpis class="grid grid-cols-[repeat(auto-fit,minmax(min(10rem,100%),1fr))] gap-3">
        <div class={kpi}>
          <dt class={kpiLabel}>Signed messages found <Help term="Signed messages found" ask="Which messages count?" text="Messages in the inspected data whose Ed25519 signature matches this DID. A message that only names the DID, without a valid signature, is not counted." /></dt>
          <dd class={kpiValue} data-kpi="signed_messages">0</dd>
        </div>
