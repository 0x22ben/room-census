---
// Overview shell: layout, navigation, tokens and help on real data. The full overview arrives in A4.
import Base from "../layouts/Base.astro";
import ClassBadge from "../components/ClassBadge.astro";
import Help from "../components/Help.astro";
import { latest } from "../lib/data";
import { dateTimeUtc } from "../lib/format";

const census = latest();
const s = census.summary;
const classes = [
  { cls: "varied", count: s.varied, help: "Rooms that look like real conversation: many regular senders and mostly unique texts." },
  { cls: "mixed", count: s.mixed, help: "Rooms between varied and repetitive: partly templated texts or few regular senders." },
  { cls: "repetitive", count: s.repetitive, help: "Rooms dominated by templates, a single sender or one-off accounts, typical of bots." },
] as const;
---
<Base title="Room Census" description="A signed, daily census of public rooms on technocore.chat.">
  <section aria-labelledby="overview-title" class="grid gap-2">
    <p class="flex items-center gap-2 font-mono text-xs font-bold tracking-widest text-text-muted uppercase">
      Census #{census.census} · {dateTimeUtc(census.at_utc)}
      <Help term="Census" ask="What is a census?" text="One daily measurement of every public Technocore room, signed by Room Census." />
    </p>
    <h1 id="overview-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Network overview</h1>
    <p class="max-w-prose text-lg text-text-secondary">{s.active} active rooms in the latest census, classified by how varied their traffic is.</p>
  </section>

  <section aria-label="Rooms by class" class="mt-6">
    <ul class="grid gap-4 sm:grid-cols-3">
      {classes.map(({ cls, count, help }) => (
        <li class="grid gap-2 rounded-lg border border-border bg-surface p-5">
          <span class="flex items-center gap-2"><ClassBadge cls={cls} /><Help term={`${cls[0].toUpperCase()}${cls.slice(1)} rooms`} ask={`What is a ${cls} room?`} text={help} /></span>
          <p class="font-mono text-3xl font-bold tabular-nums">{count}</p>
          <p class="text-text-muted">{count === 1 ? "room" : "rooms"} of {s.active}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-6 grid gap-2 rounded-lg border border-border bg-surface p-5">
    <h2 class="text-xl font-semibold">Overview in progress</h2>
    <p class="text-text-secondary">This build checks the layout, navigation, design tokens and help. Trends, the room table and verification follow in the next steps.</p>
  </section>
</Base>
