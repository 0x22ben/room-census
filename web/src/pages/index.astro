---
// Overview: is Technocore active, what changed, where to look next. Every number comes from the
// validated public data; nothing is estimated here.
import Base from "../layouts/Base.astro";
import ClassBadge from "../components/ClassBadge.astro";
import Help from "../components/Help.astro";
import LineChart from "../components/LineChart.astro";
import RoomTable, { type Row } from "../components/RoomTable.astro";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import TriangleAlert from "@lucide/astro/icons/triangle-alert";
import { censusStatus, site } from "../lib/data";
import { rules } from "../lib/method";
import { change, dateTimeUtc, median, pct, rate } from "../lib/format";

const { latest, byCensus, rooms, identity } = site();
const s = latest.summary;
const active = latest.rooms.filter((r) => r.class !== "quiet");
const quiet = latest.rooms.length - active.length;
const measured = latest.coverage?.measured ?? latest.rooms.length;
const now = byCensus[byCensus.length - 1];
const before = byCensus.length > 1 ? byCensus[byCensus.length - 2] : null;
const trafficChange = change(before?.traffic ?? null, now.traffic);
const effMedian = median(active.flatMap((r) => (r.eff_senders === undefined ? [] : [r.eff_senders])));
const uniqueMedian = median(active.flatMap((r) => (r.unique_tpl === undefined ? [] : [r.unique_tpl])));
// the headline uses traffic when rates between censuses exist, room counts otherwise
const headline = !s.baseline && s.repetitive_share !== null
  ? { value: pct(s.repetitive_share), text: "of measured Technocore traffic came from repetitive rooms." }
  : { value: `${s.repetitive} of ${s.active}`, text: "active rooms are repetitive. Traffic shares need rates between two censuses." };
const top: Row[] = [...active]
  .sort((a, b) => (b.rate_interval ?? -1) - (a.rate_interval ?? -1))
  .slice(0, 8)
  .map((r) => ({ room: r.room, cls: r.class, rate: r.rate_interval ?? null, eff: r.eff_senders ?? null, unique: r.unique_tpl ?? null }));
const labels = byCensus.map((c) => `#${c.census}`);
const kpi = "grid gap-1 rounded-lg border border-border bg-surface p-4";
const kpiLabel = "flex items-center gap-1.5 text-sm text-text-secondary";
const pill = "inline-flex min-h-11 items-center gap-1.5 rounded-md border border-border-strong px-3 font-semibold text-text no-underline";
const commit = latest.provenance?.commit;
const status = censusStatus(latest);
const rule = rules(latest);
---
<Base title="Room Census" description="A signed, daily census of public rooms on technocore.chat: which rooms talk, which rooms loop.">
  <section aria-labelledby="overview-title" class="grid gap-1.5">
    <h1 id="overview-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Network overview</h1>
    <p class="text-text-muted">A daily, signed view of public Technocore rooms.</p>
  </section>

  <div class:list={["mt-4 flex flex-wrap items-center justify-between gap-2 rounded-md border px-4 py-2.5 text-sm",
    status.complete ? "border-accent-border bg-accent-soft" : "border-warning-border bg-warning-soft"]}>
    {status.complete
      ? <span class="flex items-center gap-2 font-semibold">
          <ShieldCheck size={18} aria-hidden="true" class="text-accent" />
          Snapshot and code manifest match their published fingerprints
          <Help term="Fingerprints" ask="What does this check mean?" text="Before publishing this page, we checked that the data file of this census and the list of code that produced it match the SHA-256 fingerprints published with it. The signed message names the same fingerprints: open it to compare." />
        </span>
      : <span class="flex items-center gap-2 font-semibold">
          <TriangleAlert size={18} aria-hidden="true" class="text-warning" />
          {status.label}
          <Help term={status.label} ask="What does incomplete mean?" id="help-incomplete" text={status.help} />
        </span>}
    <span class="font-mono text-xs text-text-secondary">{dateTimeUtc(latest.at_utc)}</span>
  </div>

  <div class="mt-4 grid gap-4 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)]">
    <section aria-labelledby="headline-title" class="grid content-start gap-4 rounded-lg border border-border bg-surface p-5">
      <h2 id="headline-title" class="flex items-center gap-2 font-mono text-xs font-bold tracking-widest text-text-muted uppercase">
        Census #{latest.census}
        <Help term="Census" ask="What is a census?" text="One daily measurement of every public Technocore room, signed by Room Census." />
      </h2>
      <p class="grid gap-1">
        <span class="font-mono text-6xl font-bold tracking-tight text-repetitive">{headline.value}</span>
        <span class="font-semibold">{headline.text}</span>
      </p>
      <dl class="grid grid-cols-2 gap-3">
        <div class={kpi}>
          <dt class={kpiLabel}>Rooms <Help term="Rooms" ask="What does rooms count?" text="Public Technocore rooms measured in this census." /></dt>
          <dd class="flex items-baseline gap-2"><span class="font-mono text-2xl font-bold">{measured}</span><span class="font-mono text-xs text-text-muted">measured</span></dd>
        </div>
        <div class={kpi}>
          <dt class={kpiLabel}>Active <Help term="Active rooms" ask="What is an active room?" text="Rooms with enough recent messages to classify. The others are quiet." /></dt>
          <dd class="flex items-baseline gap-2"><span class="font-mono text-2xl font-bold">{s.active}</span><span class="font-mono text-xs text-text-muted">{quiet} quiet</span></dd>
        </div>
        <div class={kpi}>
          <dt class={kpiLabel}>Class changes <Help term="Class changes" ask="What is a class change?" text="Rooms that moved between varied, mixed and repetitive since the previous census. Rooms going quiet or waking up are not counted." /></dt>
          <dd class="flex flex-wrap items-baseline gap-x-2"><span class="font-mono text-2xl font-bold">{latest.changes.class_changes.length}</span>{before && <span class="font-mono text-xs text-text-muted">since #{before.census}</span>}</dd>
        </div>
        <div class={kpi}>
          <dt class={kpiLabel}>Traffic <Help term="Traffic" ask="What does traffic measure?" text="Messages per hour across active rooms, measured between the last two censuses." /></dt>
          <dd class="flex flex-wrap items-baseline gap-x-2"><span class="font-mono text-2xl font-bold">{now.traffic === null ? "–" : `${rate(now.traffic)}/h`}</span>{trafficChange && <span class="font-mono text-xs text-text-muted">{trafficChange}</span>}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="classes-title" class="grid content-start gap-3 rounded-lg border border-border bg-surface p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="classes-title" class="flex items-center gap-2 text-lg font-medium">
            Rooms by class
            <Help term="Rooms by class" ask="What does this chart show?" text="How many rooms were varied, mixed or repetitive at each census. One point per census: the lines only join real measurements." />
          </h2>
          <p class="text-sm text-text-muted">Active rooms per class, one point per census</p>
        </div>
        <ul class="flex flex-wrap gap-4" aria-label="Legend">
          <li><ClassBadge cls="varied" /></li><li><ClassBadge cls="mixed" /></li><li><ClassBadge cls="repetitive" /></li>
        </ul>
      </div>
      <LineChart
        labels={labels}
        min={0}
        series={[
          { label: "Varied", token: "--color-varied", values: byCensus.map((c) => c.varied) },
          { label: "Mixed", token: "--color-mixed", values: byCensus.map((c) => c.mixed) },
          { label: "Repetitive", token: "--color-repetitive", values: byCensus.map((c) => c.repetitive) },
        ]}
        summary={`Rooms by class across ${byCensus.length} censuses. Latest: ${now.varied} varied, ${now.mixed} mixed, ${now.repetitive} repetitive.`}
        caption="Counts of active rooms in each class."
      />
    </section>
  </div>

  <section aria-label="Room signals" class="mt-4 grid gap-4 md:grid-cols-3">
    <div class="grid gap-2 rounded-lg border border-border bg-surface p-5">
      <h2 class="flex items-center gap-2 font-semibold">Room mix <Help term="Room mix" ask="How are rooms classified?" text="Every room gets a class from how its messages look: varied (real conversation), mixed, or repetitive (templates, bots)." href="#method" /></h2>
      <p class="text-2xl font-bold">{s.repetitive} repetitive</p>
      <p class="text-sm text-text-muted">{s.varied} varied · {s.mixed} mixed · {quiet} quiet</p>
    </div>
    <div class="grid gap-2 rounded-lg border border-border bg-surface p-5">
      <h2 class="flex items-center gap-2 font-semibold">Effective senders <Help term="Effective senders" ask="What are effective senders?" id="help-eff-card" text="How many senders really carry a room. A room where one bot writes most messages counts as about one sender." href="#method" /></h2>
      <p class="text-2xl font-bold">{effMedian === null ? "–" : `${Math.round(effMedian)} median`}</p>
      <p class="text-sm text-text-muted">Effective senders per active room</p>
    </div>
    <div class="grid gap-2 rounded-lg border border-border bg-surface p-5">
      <h2 class="flex items-center gap-2 font-semibold">Text diversity <Help term="Text diversity" ask="What is text diversity?" text="Share of messages that are not copies of the same template, once numbers are masked." href="#method" /></h2>
      <p class="text-2xl font-bold">{uniqueMedian === null ? "–" : `${pct(uniqueMedian)} unique`}</p>
      <p class="text-sm text-text-muted">Median share of unique texts per active room</p>
    </div>
  </section>

  <section id="rooms" aria-labelledby="rooms-title" class="mt-4 scroll-mt-4 overflow-hidden rounded-lg border border-border bg-surface">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3">
      <div>
        <h2 id="rooms-title" class="text-lg font-medium">Busiest rooms</h2>
        <p class="text-sm text-text-muted">{s.baseline ? "Latest census · no rates between censuses yet" : "Latest census · sorted by messages per hour"}</p>
      </div>
      <a href="/rooms/" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-accent-border bg-accent-soft px-4 text-sm font-semibold text-text no-underline">
        View all {rooms.size} <ArrowRight size={16} aria-hidden="true" class="text-accent" />
      </a>
    </div>
    <RoomTable rows={top} caption={`The ${top.length} busiest rooms of census #${latest.census}`} />
  </section>

  <section id="trust" aria-labelledby="trust-title" class="mt-4 grid scroll-mt-4 gap-4 rounded-lg border border-border bg-surface p-5 md:grid-cols-[auto_1fr]">
    <span class="grid size-12 place-items-center rounded-lg border border-accent-border bg-accent-soft"><ShieldCheck size={22} aria-hidden="true" class="text-accent" /></span>
    <div class="grid gap-3">
      <div>
        <h2 id="trust-title" class="font-medium">Independently verifiable</h2>
        <p class="text-sm text-text-muted">The signed message, the data file and the code that produced this census are all public.</p>
      </div>
      <ul class="flex flex-wrap gap-2 text-sm">
        {latest.signed_in && <li><a class={pill} href={`https://technocore.chat/r/${identity.room}`}>Signed message <ArrowUpRight size={14} aria-hidden="true" /></a></li>}
        <li><a class={pill} href={`/${latest.snapshot}`}>Snapshot</a></li>
        {latest.provenance && <li><a class={pill} href={`/${latest.provenance.manifest}`}>Code manifest</a></li>}
        {commit && <li><a class={pill} href={`${latest.provenance?.repository}/tree/${commit}`}>Source at {commit.slice(0, 8)} <ArrowUpRight size={14} aria-hidden="true" /></a></li>}
      </ul>
      <p class="font-mono text-xs break-all text-text-muted">sha256 {latest.sha256}{latest.signed_in && ` · nonce ${latest.signed_in.nonce}`}</p>
    </div>
  </section>

  <section id="method" aria-labelledby="method-title" class="mt-4 grid scroll-mt-4 gap-3 rounded-lg border border-border bg-surface p-5">
    <h2 id="method-title" class="text-lg font-medium">How Room Census works</h2>
    <ul class="grid gap-3 text-text-secondary md:grid-cols-2">
      <li><span class="font-semibold text-text">Once a day</span>, Room Census reads every public room of technocore.chat and measures its messages. {latest.next}.</li>
      <li><span class="font-semibold text-text">Varied</span> rooms have {rule.varied}.</li>
      <li><span class="font-semibold text-text">Repetitive</span> rooms have {rule.repetitive}. <span class="font-semibold text-text">Mixed</span> rooms are everything in between.</li>
      <li><span class="font-semibold text-text">Quiet rooms</span> have {rule.quiet}: too little to classify.</li>
      <li><span class="font-semibold text-text">Limits.</span> Metrics use windows of {rule.window} messages. Identities are free and texts can be varied, so every metric can be gamed: unique text does not mean human.</li>
    </ul>
  </section>
</Base>
