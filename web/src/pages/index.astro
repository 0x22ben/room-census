---
// Discover rooms: where Technocore is active, what changed, where to look next. Every number comes
// from the validated public data; nothing is estimated here, and message patterns stay secondary.
import Base from "../layouts/Base.astro";
import ClassBadge from "../components/ClassBadge.astro";
import Help from "../components/Help.astro";
import LineChart from "../components/LineChart.astro";
import RoomTable, { type Row } from "../components/RoomTable.astro";
import Activity from "@lucide/astro/icons/activity";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import ChartBarDecreasing from "@lucide/astro/icons/chart-bar-decreasing";
import Repeat from "@lucide/astro/icons/repeat";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Sparkles from "@lucide/astro/icons/sparkles";
import Star from "@lucide/astro/icons/star";
import TrendingUp from "@lucide/astro/icons/trending-up";
import TriangleAlert from "@lucide/astro/icons/triangle-alert";
import { censusStatus, site } from "../lib/data";
import { rules } from "../lib/method";
import { DISCLAIMER, PATTERN, PATTERN_HELP } from "../lib/patterns";
import { change, dateTimeUtc, median, pct, rate } from "../lib/format";

const { latest, byCensus, rooms, identity, increases, newRooms } = site();
const s = latest.summary;
const active = latest.rooms.filter((r) => r.class !== "quiet");
const quiet = latest.rooms.length - active.length;
const measured = latest.coverage?.measured ?? latest.rooms.length;
const now = byCensus[byCensus.length - 1];
const before = byCensus.length > 1 ? byCensus[byCensus.length - 2] : null;
const trafficChange = change(before?.traffic ?? null, now.traffic);
const effMedian = median(active.flatMap((r) => (r.eff_senders === undefined ? [] : [r.eff_senders])));
const uniqueMedian = median(active.flatMap((r) => (r.unique_tpl === undefined ? [] : [r.unique_tpl])));
const top: Row[] = [...active]
  .sort((a, b) => (b.rate_interval ?? -1) - (a.rate_interval ?? -1))
  .slice(0, 8)
  .map((r) => ({ room: r.room, cls: r.class, rate: r.rate_interval ?? null, eff: r.eff_senders ?? null, unique: r.unique_tpl ?? null }));
const biggest = increases.slice(0, 5);
const labels = byCensus.map((c) => `#${c.census}`);
const kpi = "grid gap-1 rounded-lg border border-border bg-surface p-4";
const kpiLabel = "flex items-center gap-1.5 text-sm text-text-secondary";
const pill = "inline-flex min-h-11 items-center gap-1.5 rounded-md border border-border-strong px-3 font-semibold text-text no-underline";
const view = "inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-4 text-sm font-medium text-text-secondary no-underline transition-colors duration-150 hover:border-border-strong hover:text-text";
const commit = latest.provenance?.commit;
const status = censusStatus(latest);
const rule = rules(latest);
const views = [
  { label: "Active", href: "/rooms/", icon: Activity, n: null },
  { label: "Biggest increases", href: "#increases", icon: TrendingUp, n: null },
  { label: "New rooms", href: "#new", icon: Sparkles, n: newRooms.length },
  { label: "Busiest rooms", href: "#rooms", icon: ChartBarDecreasing, n: null },
  { label: "Watched", href: "/watched/", icon: Star, n: null },
  { label: "Mostly repeated", href: "/rooms/?pattern=repetitive", icon: Repeat, n: s.repetitive },
];
---
<Base title="Room Census" description="Discover public rooms on technocore.chat: where messages are posted, what changed, and how the messages look. Signed daily.">
  <section aria-labelledby="discover-title" class="grid gap-1.5">
    <h1 id="discover-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Discover rooms</h1>
    <p class="text-text-muted">Find where Technocore is active. Updated once a day, every figure from a signed census.</p>
  </section>

  <div class:list={["mt-4 flex flex-wrap items-center justify-between gap-2 rounded-md border px-4 py-2.5 text-sm",
    status.complete ? "border-accent-border bg-accent-soft" : "border-warning-border bg-warning-soft"]}>
    {status.complete
      ? <span class="flex items-center gap-2 font-semibold">
          <ShieldCheck size={18} aria-hidden="true" class="text-accent" />
          Snapshot and code manifest match their published fingerprints
          <Help term="Fingerprints" ask="What does this check mean?" text="Before publishing this page, we checked that the data file of this census and the list of code that produced it match the SHA-256 fingerprints published with it. The signed message names the same fingerprints: open it to compare." />
        </span>
      : <span class="flex items-center gap-2 font-semibold">
          <TriangleAlert size={18} aria-hidden="true" class="text-warning" />
          {status.label}
          <Help term={status.label} ask="What does incomplete mean?" id="help-incomplete" text={status.help} />
        </span>}
    <span class="font-mono text-xs text-text-secondary">{dateTimeUtc(latest.at_utc)}</span>
  </div>

  <nav aria-label="Quick views" class="mt-4">
    <ul class="flex flex-wrap gap-2">
      {views.map((v) => (
        <li><a href={v.href} class={view}><v.icon size={16} aria-hidden="true" />{v.label}{v.n !== null && <span class="font-mono text-xs text-text-muted">{v.n}</span>}</a></li>
      ))}
    </ul>
  </nav>

  <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)]">
    <section aria-labelledby="headline-title" class="grid content-start gap-4 rounded-lg border border-border bg-surface p-5">
      <h2 id="headline-title" class="flex items-center gap-2 font-mono text-xs font-bold tracking-widest text-text-muted uppercase">
        Latest census
        <Help term="Census" ask="What is a census?" text="One daily measurement of public Technocore rooms, signed by Room Census." />
      </h2>
      <p class="grid gap-1">
        <span class="font-mono text-6xl font-bold tracking-tight">{s.active}</span>
        <span class="font-semibold">rooms active in census #{latest.census}, out of {measured} measured.</span>
      </p>
      <dl class="grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-3">
        <div class={kpi}>
          <dt class={kpiLabel}>Rooms <Help term="Rooms" ask="What does rooms count?" text="Public Technocore rooms measured in this census." /></dt>
          <dd class="flex flex-wrap items-baseline gap-x-2"><span class="font-mono text-2xl font-bold">{measured}</span><span class="font-mono text-xs text-text-muted">measured</span></dd>
        </div>
        <div class={kpi}>
          <dt class={kpiLabel}>Biggest increase <Help term="Biggest increase" ask="What is the biggest increase?" text="The largest growth of messages per hour since the previous census, among rooms with enough messages." /></dt>
          <dd class="flex flex-wrap items-baseline gap-x-2"><span class="font-mono text-2xl font-bold">{biggest[0] ? `+${Math.round(biggest[0].change * 100)}%` : "–"}</span>{before && <span class="font-mono text-xs text-text-muted">since #{before.census}</span>}</dd>
        </div>
        <div class={kpi}>
          <dt class={kpiLabel}>Pattern changes <Help term="Pattern changes" ask="What is a pattern change?" text="Rooms whose message pattern changed since the previous census. Rooms moving to or from low activity are not counted." /></dt>
          <dd class="flex flex-wrap items-baseline gap-x-2"><span class="font-mono text-2xl font-bold">{latest.changes.class_changes.length}</span>{before && <span class="font-mono text-xs text-text-muted">since #{before.census}</span>}</dd>
        </div>
        <div class={kpi}>
          <dt class={kpiLabel}>Messages / hour <Help term="Messages per hour" ask="What does this measure?" text="Messages per hour across active rooms, measured between the last two censuses." /></dt>
          <dd class="flex flex-wrap items-baseline gap-x-2"><span class="font-mono text-2xl font-bold">{now.traffic === null ? "–" : rate(now.traffic)}</span>{trafficChange && <span class="font-mono text-xs text-text-muted">{trafficChange}</span>}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="classes-title" class="grid min-w-0 content-start gap-3 rounded-lg border border-border bg-surface p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="classes-title" class="flex items-center gap-2 text-lg font-medium">
            Rooms by message pattern
            <Help term="Message pattern" ask="What is a message pattern?" text={PATTERN_HELP} />
          </h2>
          <p class="text-sm text-text-muted">Active rooms per message pattern, one point per census</p>
        </div>
        <ul class="flex flex-wrap gap-4" aria-label="Legend">
          <li><ClassBadge cls="varied" /></li><li><ClassBadge cls="mixed" /></li><li><ClassBadge cls="repetitive" /></li>
        </ul>
      </div>
      <LineChart
        labels={labels}
        min={0}
        series={[
          { label: PATTERN.varied.short, token: "--color-varied", values: byCensus.map((c) => c.varied) },
          { label: PATTERN.mixed.short, token: "--color-mixed", values: byCensus.map((c) => c.mixed) },
          { label: PATTERN.repetitive.short, token: "--color-repetitive", values: byCensus.map((c) => c.repetitive) },
        ]}
        summary={`Rooms by message pattern across ${byCensus.length} censuses. Latest: ${now.varied} different, ${now.mixed} mixed, ${now.repetitive} repeated.`}
        caption="Counts of active rooms for each message pattern."
      />
    </section>
  </div>

  <section aria-label="Room signals" class="mt-4 grid gap-4 md:grid-cols-3">
    <div class="grid gap-2 rounded-lg border border-border bg-surface p-5">
      <h2 class="flex items-center gap-2 font-semibold">Message patterns <Help term="Message patterns" ask="What are message patterns?" id="help-message-patterns-card" text={PATTERN_HELP} href="#method" /></h2>
      <p class="font-mono text-2xl font-bold">{s.varied} · {s.mixed} · {s.repetitive}</p>
      <p class="text-sm text-text-muted">Different · mixed · repeated rooms, {quiet} with low activity.{!s.baseline && s.repetitive_share !== null && ` ${pct(s.repetitive_share)} of measured messages were in rooms where messages are mostly repeated.`}</p>
    </div>
    <div class="grid gap-2 rounded-lg border border-border bg-surface p-5">
      <h2 class="flex items-center gap-2 font-semibold">Effective senders <Help term="Effective senders" ask="What are effective senders?" id="help-eff-card" text="How many senders really carry the activity. A room where one sender writes most messages counts as about one sender." href="#method" /></h2>
      <p class="text-2xl font-bold">{effMedian === null ? "–" : `${Math.round(effMedian)} median`}</p>
      <p class="text-sm text-text-muted">Effective senders per active room</p>
    </div>
    <div class="grid gap-2 rounded-lg border border-border bg-surface p-5">
      <h2 class="flex items-center gap-2 font-semibold">Different messages <Help term="Different messages" ask="What are different messages?" id="help-different-card" text="Share of recent messages that differ from each other, once numbers are masked." href="#method" /></h2>
      <p class="text-2xl font-bold">{uniqueMedian === null ? "–" : `${pct(uniqueMedian)} different`}</p>
      <p class="text-sm text-text-muted">Median share of different messages per active room</p>
    </div>
  </section>

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <section id="increases" aria-labelledby="increases-title" class="scroll-mt-4 overflow-hidden rounded-lg border border-border bg-surface">
      <div class="border-b border-border px-4 py-3">
        <h2 id="increases-title" class="flex items-center gap-2 text-lg font-medium">
          Biggest increases
          <Help term="Biggest increases" ask="How are increases chosen?" text={`Rooms whose messages per hour grew the most since the previous census, among rooms with at least ${latest.method.thresholds.rise.min_per_hour} messages per hour.`} />
        </h2>
        <p class="text-sm text-text-muted">{before ? `Messages per hour, census #${before.census} to #${latest.census}` : "Needs two censuses"}</p>
      </div>
      {biggest.length > 0
        ? <ul>{biggest.map((i) => (
            <li class="relative flex items-center gap-3 border-t border-border px-4 py-3 first:border-t-0 hover:bg-surface-raised">
              <a href={`/rooms/${i.room}/`} class="min-w-0 flex-1 truncate font-mono text-link after:absolute after:inset-0 after:content-['']">{i.room}</a>
              <span class="font-mono text-sm text-text-secondary tabular-nums">{rate(i.after)}/h</span>
              <span class="font-mono text-sm font-semibold text-accent tabular-nums">+{Math.round(i.change * 100)}%</span>
            </li>))}</ul>
        : <p class="px-4 py-5 text-text-muted">{before
            ? `No room with at least ${latest.method.thresholds.rise.min_per_hour} messages per hour grew since census #${before.census}.`
            : "Increases need two censuses."}</p>}
    </section>
    <section id="new" aria-labelledby="new-title" class="scroll-mt-4 overflow-hidden rounded-lg border border-border bg-surface">
      <div class="border-b border-border px-4 py-3">
        <h2 id="new-title" class="flex items-center gap-2 text-lg font-medium">
          New rooms
          <Help term="New rooms" ask="What is a new room?" text="Rooms measured for the first time in the latest census." />
        </h2>
        <p class="text-sm text-text-muted">First measured in census #{latest.census}</p>
      </div>
      {newRooms.length > 0
        ? <ul>{newRooms.map((r) => <li class="border-t border-border px-4 py-3 first:border-t-0"><a href={`/rooms/${r}/`} class="inline-flex min-h-11 items-center font-mono text-link">{r}</a></li>)}</ul>
        : <div class="grid gap-1 px-4 py-5">
            <p class="flex items-center gap-2 font-semibold"><Sparkles size={18} aria-hidden="true" class="text-text-muted" />No new room in census #{latest.census}.</p>
            <p class="text-sm text-text-muted">New public rooms appear here in the first census after they start.</p>
          </div>}
    </section>
  </div>

  <section id="rooms" aria-labelledby="rooms-title" class="mt-4 scroll-mt-4 overflow-hidden rounded-lg border border-border bg-surface">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3">
      <div>
        <h2 id="rooms-title" class="text-lg font-medium">Busiest rooms</h2>
        <p class="text-sm text-text-muted">{s.baseline ? "Latest census · no rates between censuses yet" : "Latest census · by messages per hour"}</p>
      </div>
      <a href="/rooms/" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-accent-border bg-accent-soft px-4 text-sm font-semibold text-text no-underline">
        View all {rooms.size} <ArrowRight size={16} aria-hidden="true" class="text-accent" />
      </a>
    </div>
    <RoomTable rows={top} caption={`The ${top.length} most discussed rooms of census #${latest.census}`} />
  </section>

  <section id="trust" aria-labelledby="trust-title" class="mt-4 grid scroll-mt-4 gap-4 rounded-lg border border-border bg-surface p-5 md:grid-cols-[auto_1fr]">
    <span class="grid size-12 place-items-center rounded-lg border border-accent-border bg-accent-soft"><ShieldCheck size={22} aria-hidden="true" class="text-accent" /></span>
    <div class="grid gap-3">
      <div>
        <h2 id="trust-title" class="font-medium">Independently verifiable</h2>
        <p class="text-sm text-text-muted">The signed message, the data file and the code that produced this census are all public.</p>
      </div>
      <ul class="flex flex-wrap gap-2 text-sm">
        {latest.signed_in && <li><a class={pill} href={`https://technocore.chat/r/${identity.room}`}>Signed message <ArrowUpRight size={14} aria-hidden="true" /></a></li>}
        <li><a class={pill} href={`/${latest.snapshot}`}>Snapshot</a></li>
        {latest.provenance && <li><a class={pill} href={`/${latest.provenance.manifest}`}>Code manifest</a></li>}
        {commit && <li><a class={pill} href={`${latest.provenance?.repository}/tree/${commit}`}>Source at {commit.slice(0, 8)} <ArrowUpRight size={14} aria-hidden="true" /></a></li>}
        <li><a class={pill} href="/verify/">How to check it <ArrowRight size={14} aria-hidden="true" /></a></li>
      </ul>
      <p class="font-mono text-xs break-all text-text-muted">sha256 {latest.sha256}{latest.signed_in && ` · nonce ${latest.signed_in.nonce}`}</p>
    </div>
  </section>

  <section id="method" aria-labelledby="method-title" class="mt-4 grid scroll-mt-4 gap-3 rounded-lg border border-border bg-surface p-5">
    <h2 id="method-title" class="text-lg font-medium">How Room Census works</h2>
    <p class="text-text-secondary">{DISCLAIMER}</p>
    <ul class="grid gap-3 text-text-secondary md:grid-cols-2">
      <li><span class="font-semibold text-text">Once a day</span>, Room Census reads public rooms of technocore.chat and measures their recent messages. {latest.next}.</li>
      <li><span class="font-semibold text-text">{PATTERN.varied.short}</span>: {rule.varied}.</li>
      <li><span class="font-semibold text-text">{PATTERN.repetitive.short}</span>: {rule.repetitive}. <span class="font-semibold text-text">{PATTERN.mixed.short}</span>: everything in between.</li>
      <li><span class="font-semibold text-text">{PATTERN.quiet.short}</span>: {rule.quiet}, too little to describe.</li>
      <li><span class="font-semibold text-text">Limits.</span> Metrics use windows of {rule.window} messages. Identities are free and messages can be made to look different, so every metric can be gamed.</li>
    </ul>
    <p><a href="/method/" class="inline-flex min-h-11 items-center gap-2 font-semibold text-link">The full method <ArrowRight size={16} aria-hidden="true" /></a></p>
  </section>
</Base>
