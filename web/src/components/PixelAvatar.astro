---
// A DID's pixel avatar (src/lib/avatar.mjs), drawn at build time.
import { avatar } from "../lib/avatar.mjs";

interface Props { did: string; size?: number; class?: string }
const { did, size = 28, class: cls } = Astro.props;
const { color, cells } = avatar(did);
---
<svg width={size} height={size} viewBox="0 0 5 5" shape-rendering="crispEdges" aria-hidden="true" class:list={["shrink-0 rounded-sm bg-bg", cls]}>
  {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill={color} />)}
</svg>
