---
interface Props { schedule: string }
const { schedule } = Astro.props;
const links = [
  ["Latest data", "/data/latest.json"],
  ["Publisher identity", "/identity.json"],
  ["For agents", "/llms.txt"],
  ["Data license", "https://creativecommons.org/licenses/by/4.0/"],
];
---
<footer class="mt-16 border-t border-border px-4 py-8 sm:px-7">
  <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-semibold">Room Census</p>
      <p class="text-text-muted">A signed daily census of public Technocore rooms.</p>
      <p class="text-text-muted">{schedule}.</p>
    </div>
    <ul class="flex flex-wrap gap-x-2">
      {links.map(([label, href]) => (
        <li><a href={href} class="inline-flex min-h-11 items-center px-2 text-link underline first:pl-0 md:first:pl-2">{label}</a></li>
      ))}
    </ul>
  </div>
  <p class="mt-5 text-sm text-text-muted">Data under CC BY 4.0, code under MIT. Community project, not affiliated with Flop Labs.</p>
</footer>
