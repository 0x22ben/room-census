---
// The navigation of the sidebar, also used by the mobile menu. Only pages that exist are listed.
import NavIcon from "./NavIcon.astro";
import { NAV_FOOTER, isActive, readySections } from "../lib/site";
import { SAMPLE, contests, phaseOf } from "../lib/contests";

interface Props { label: string }
const pathname = Astro.url.pathname;
const sections = readySections();
const footer = NAV_FOOTER.filter((i) => i.ready);
// compact on the desktop sidebar (Pencil hHTyx, 34 px rows); 44 px touch rows in the mobile menu
const item = "flex h-11 items-center gap-3 rounded-md px-3 text-base transition-colors duration-150 lg:h-8.5 lg:gap-2.5 lg:px-2.5 lg:text-sm";
// "Live" beside Contests only when the site shows the witness's real data and trading is open
const live = !SAMPLE && contests().some((c) => phaseOf(c) === "live");
---
<nav aria-label={Astro.props.label} class="flex flex-1 flex-col">
  {sections.map((section) => (
    <div class="mt-4 first:mt-0 lg:mt-3">
      <p class="px-3 pb-1.5 font-mono text-xs font-bold tracking-widest text-text-muted uppercase lg:px-2.5 lg:pb-1 lg:text-[10px]">{section.label}</p>
      <ul class="flex flex-col gap-1.5 lg:gap-0.5">
        {section.items.map((i) => {
          const on = isActive(i, pathname);
          return (
            <li>
              <a href={i.href} aria-current={on ? "page" : undefined}
                class:list={[item, on ? "bg-surface-raised font-semibold text-text" : "font-medium text-text-secondary hover:bg-surface hover:text-text"]}>
                <NavIcon name={i.icon} /><span>{i.label}</span>
                {live && i.href === "/contests/" && <span data-nav-badge aria-hidden="true" class="ml-auto rounded border border-accent-border bg-accent-soft px-1.5 font-mono text-[10px] font-bold tracking-widest text-accent uppercase">Live</span>}
                {i.href === "/rankings/" && <span data-nav-badge aria-hidden="true" class="ml-auto rounded border border-warning-border bg-warning-soft px-1.5 font-mono text-[10px] font-bold tracking-widest text-warning uppercase">Beta</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
  <ul class="mt-auto flex flex-col gap-1.5 border-t border-border pt-4 lg:gap-0.5 lg:pt-2">
    {footer.map((i) => {
      const on = isActive(i, pathname);
      return (
        <li>
          <a href={i.href} aria-current={on ? "page" : undefined}
            class:list={[item, on ? "bg-surface-raised font-semibold text-text" : "font-medium text-text-secondary hover:bg-surface hover:text-text"]}>
            <NavIcon name={i.icon} /><span>{i.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
