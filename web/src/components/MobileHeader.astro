---
// Small screens: brand and a menu button that opens the same navigation. Native <details>, so
// the menu works by keyboard and without script.
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import Logo from "./Logo.astro";
import NavList from "./NavList.astro";
import { SITE_NAME } from "../lib/site";
---
<div class="relative border-b border-border bg-bg lg:hidden">
  <div class="flex min-h-14 items-center justify-between px-4">
    <a href="/" aria-label={`${SITE_NAME}, overview`} class="flex min-h-11 items-center gap-3 text-text no-underline">
      <Logo />
      <span class="font-mono text-sm font-bold tracking-[0.12em] uppercase">{SITE_NAME}</span>
    </a>
    <details class="group">
      <summary aria-label="Menu" class="grid size-11 cursor-pointer list-none place-items-center rounded-md border border-border-strong text-text [&::-webkit-details-marker]:hidden">
        <Menu size={20} aria-hidden="true" class="group-open:hidden" />
        <X size={20} aria-hidden="true" class="hidden group-open:block" />
      </summary>
      <div class="absolute inset-x-0 top-full z-20 flex border-b border-border bg-bg px-3.5 py-4 shadow-2xl shadow-shadow/40">
        <NavList label="Menu" />
      </div>
    </details>
  </div>
</div>
