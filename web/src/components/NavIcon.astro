---
// Lucide icons for the navigation, rendered as static SVG at build time.
import Compass from "@lucide/astro/icons/compass";
import List from "@lucide/astro/icons/list";
import Star from "@lucide/astro/icons/star";
import UserRound from "@lucide/astro/icons/user-round";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Database from "@lucide/astro/icons/database";
import BookOpen from "@lucide/astro/icons/book-open";
import Code from "@lucide/astro/icons/code";
import type { Icon } from "../lib/site";

interface Props { name: Icon }
const ICONS = { discover: Compass, rooms: List, watched: Star, did: UserRound, verify: ShieldCheck, data: Database, method: BookOpen, source: Code };
const Component = ICONS[Astro.props.name];
---
<Component size={18} aria-hidden="true" class="shrink-0" />
