---
// The top of every contest page: way back to the list, title with its state, sample notice and tabs.
// The state pill says whether every check passed; the details are on the Verify tab.
import Px from "./Px.astro";
import { SAMPLE, CAPTURED_AT, phaseLabel, phaseOf, tabs, tally, type Contest } from "../lib/contests";
import { dateTimeUtc } from "../lib/format";

interface Props { contest: Contest; current: string }
const { contest: c, current } = Astro.props;
const t = tally(c.checks);
const clean = t.warn === 0 && t.wait === 0;
const live = phaseOf(c) === "live";
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex items-center gap-1.5">
    <li><a href="/contests/" class="inline-flex min-h-11 items-center gap-1.5 text-link no-underline hover:underline"><Px name="arrow-left" size={12} />Contests</a></li>
    <li aria-hidden="true" class="text-text-muted">/</li>
    <li aria-current="page" class="text-text-secondary">{c.short}</li>
  </ol>
</nav>
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">{c.title}</h1>
  <a href={`/contests/${c.id}/verify/`} class:list={["inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 text-xs font-semibold no-underline",
    clean ? "border-accent-border bg-accent-soft text-accent" : "border-warning-border bg-warning-soft text-warning"]}>
    {live && <span aria-hidden="true" class="size-1.5 rounded-full bg-current"></span>}
    {phaseLabel(phaseOf(c))} · {clean ? "verified" : `${t.warn + t.wait} to read`}
  </a>
</div>
{SAMPLE && (
  <p class="mt-3 flex items-start gap-2 rounded-md border border-border bg-surface px-3 py-2 text-sm text-text-secondary">
    <Px name="info-box" size={12} class="mt-1 shrink-0 text-text-muted" />
    <span>Sample data: a copy of our capture from {dateTimeUtc(CAPTURED_AT)}. This page does not update yet.</span>
  </p>
)}
<nav aria-label="Contest sections" class="mt-4 border-b border-border">
  <ul class="flex gap-1 overflow-x-auto">
    {tabs(c).map((tab) => {
      const on = tab.label === current;
      return (
        <li>
          <a href={tab.href} aria-current={on ? "page" : undefined}
            class:list={["inline-flex min-h-11 items-center border-b-2 px-3.5 text-sm no-underline",
              on ? "border-accent font-semibold text-text" : "border-transparent font-medium text-text-secondary hover:text-text"]}>{tab.label}</a>
        </li>
      );
    })}
  </ul>
</nav>
