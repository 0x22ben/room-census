---
// The top of every contest page: way back to the list, title, one-line summary, sample notice and tabs.
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import Info from "@lucide/astro/icons/info";
import { SAMPLE, CAPTURED_AT, tabs, type Contest } from "../lib/contests";
import { dateTimeUtc } from "../lib/format";

interface Props { contest: Contest; current: string }
const { contest: c, current } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex items-center gap-1.5">
    <li><a href="/contests/" class="inline-flex min-h-11 items-center gap-1.5 text-link no-underline hover:underline"><ArrowLeft size={14} aria-hidden="true" />Contests</a></li>
    <li aria-hidden="true" class="text-text-muted">/</li>
    <li aria-current="page" class="text-text-secondary">{c.short}</li>
  </ol>
</nav>
<section aria-labelledby="contest-title" class="grid gap-1.5">
  <h1 id="contest-title" class="text-3xl font-medium tracking-tight sm:text-4xl">{c.title}</h1>
  <p class="text-text-muted">{c.summary}</p>
</section>
<p class="mt-3 flex items-start gap-2 rounded-md border border-border bg-surface px-3 py-2 text-sm text-text-secondary">
  <Info size={16} aria-hidden="true" class="mt-0.5 shrink-0 text-text-muted" />
  {SAMPLE
    ? <span>Sample data: a copy of our capture from {dateTimeUtc(CAPTURED_AT)}. This page does not update yet.</span>
    : <span>From our capture of {dateTimeUtc(CAPTURED_AT)}. This page is rebuilt about once an hour.</span>}
</p>
<nav aria-label="Contest sections" class="mt-4 border-b border-border">
  <ul class="flex gap-1 overflow-x-auto">
    {tabs(c).map((t) => {
      const on = t.label === current;
      return (
        <li>
          <a href={t.href} aria-current={on ? "page" : undefined}
            class:list={["inline-flex min-h-11 items-center border-b-2 px-3.5 text-sm no-underline",
              on ? "border-accent font-semibold text-text" : "border-transparent font-medium text-text-secondary hover:text-text"]}>{t.label}</a>
        </li>
      );
    })}
  </ul>
</nav>
