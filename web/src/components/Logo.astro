---
// The Room Census mark: four room bars crossed by the census line. Decorative next to the name.
---
<svg class="logo" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="7" class="logo-tile" />
  <path d="M9 8v16M14 8v16M19 8v16M24 8v16M6 21l22-10" class="logo-lines" />
</svg>

<style>
  .logo { flex: none; display: block; }
  .logo-tile { fill: var(--color-surface-raised); stroke: var(--color-border-strong); stroke-width: 1; }
  .logo-lines { fill: none; stroke: var(--color-accent); stroke-width: 2.6; stroke-linecap: round; }
</style>
