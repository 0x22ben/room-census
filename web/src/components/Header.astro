---
import Logo from "./Logo.astro";
import { NAV, SITE_NAME, isActive } from "../lib/site";

const pathname = Astro.url.pathname;
const items = NAV.filter((item) => item.ready);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE_NAME}, overview`}>
      <Logo />
      <span class="brand-name">{SITE_NAME}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item, pathname) ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-5);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target-min);
    color: var(--color-text);
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--target-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    min-width: var(--target-min);
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    font-weight: 550;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease), color var(--motion-fast) var(--ease);
  }
  nav a:hover { color: var(--color-text); background: var(--color-surface); }
  /* the current page is marked by weight and an underline, not by color alone */
  nav a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  @media (max-width: 30rem) {
    .bar { padding-block: var(--space-2); }
    nav { width: 100%; }
    nav a { padding: 0 var(--space-3) 0 0; }
    nav a[aria-current="page"] { padding-inline: 0 var(--space-3); }
  }
</style>
